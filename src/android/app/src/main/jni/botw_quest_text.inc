
constexpr std::array<QuestText, 668> BotwQuestText{{
    QuestText{"QL_100enemy_Active", "You have overcome part of the Trial,\nallowing you to wield more of the\nMaster Sword's power.\n\nBut the Trial of the Sword has yet to be\ncompletely conquered... Continue the Trial\nto unlock the true splendor of the Master Sword!"},
    QuestText{"QL_100enemy_Active2", "You have overcome parts of the Trial,\nallowing you to wield even more of\nthe Master Sword's power.\n\nBut the Trial of the Sword continues...\nPersevere until you have unlocked the\ntrue splendor of the Master Sword!"},
    QuestText{"QL_100enemy_Active3", "When you returned the Master Sword to its\npedestal, you were transported to a shrine\nin a strange place, and a mysterious voice\nspoke to you.\n\nThe voice said to overcome all obstacles using\nnone of the weapons or armor you have\ngathered so far. Succeed, and you will unlock\nthe true splendor of the Master Sword."},
    QuestText{"QL_100enemy_Desc", "You heard a mysterious voice that mentioned\nsomething about a glorious trial...\n\nWhat could this trial be? The voice instructed\nyou to speak with the Great Deku Tree at\nKorok Forest to take on the challenge..."},
    QuestText{"QL_100enemy_Finish", "You conquered the merciless Trial of the Sword!\n\nYou now have the physical and mental strength\nnecessary to use the Master Sword to its\nfull potential.\n\nPrincess Zelda is no doubt quite happy\nwith your achievement."},
    QuestText{"QL_100enemy_Name", "EX Trial of the Sword"},
    QuestText{"QL_100enemy_ToDeku", "According to the Great Deku Tree,\nthe Master Sword's true splendor has yet\nto be awakened. To do so, you must\nconquer the Trial of the Sword. \n\nChallenge the Trial of the Sword by placing\nthe Master Sword in its pedestal."},
    QuestText{"QL_Animal_Forest_Desc", "\"A beast that wears a crown of bone,\nPrancing through the lush green.\nMount the beast upon its throne, \nFor only then the shrine is seen.\"\n\nThis is a song that Kass sang.\nSolve the song's riddle to find the\nshrine."},
    QuestText{"QL_Animal_Forest_Finish", "\"A beast that wears a crown of bone,\nPrancing through the lush green.\nMount the beast upon its throne, \nFor only then the shrine is seen.\"\n\nThe beast wearing a crown of bone was a\nmountain buck.\n\nAs the song instructed, being atop a mountain\nbuck while it stood on the pedestal caused the\nshrine to appear."},
    QuestText{"QL_Animal_Forest_Name", "The Crowned Beast"},
    QuestText{"QL_BalladOfHeroGerudo_Desc", "The scattered One-Hit Obliterator led you to a\nlocation where a stone monument with a map of\ntrials appeared. Kass's song seems related...\n\nOne, fight the brute of the sand.\nTwo, chase rings upon the land.\nThree, throw the orb underground.\nChampion, trials abound!\n\nYou still have three trials to complete."},
    QuestText{"QL_BalladOfHeroGerudo_Finish", "You defeated the phantasm of Thunderblight\nGanon, which was born from your own\nmemories and fears.\n\nKass's composition, entitled Champion Urbosa's\nSong, was so true and moving that it allowed\nyou to visualize a memory from 100 years ago.\n\nBy conquering the trial, your sacred power has\nincreased and Urbosa's Fury has become more\nefficient than ever."},
    QuestText{"QL_BalladOfHeroGerudo_Name", "EX Champion Urbosa's Song"},
    QuestText{"QL_BalladOfHeroGerudo_Seek1stDungeon", "The scattered One-Hit Obliterator led you to a\nlocation where a stone monument with a map of\ntrials appeared. Kass's song seems related...\n\nOne, fight the brute of the sand.\nTwo, chase rings upon the land.\nThree, throw the orb underground.\nChampion, trials abound!\n\nYou still have two trials to complete."},
    QuestText{"QL_BalladOfHeroGerudo_Seek2ndDungeon", "The scattered One-Hit Obliterator led you to a\nlocation where a stone monument with a map of\ntrials appeared. Kass's song seems related...\n\nOne, fight the brute of the sand.\nTwo, chase rings upon the land.\nThree, throw the orb underground.\nChampion, trials abound!\n\nYou still have one trial to complete."},
    QuestText{"QL_BalladOfHeroGerudo_Seek3rdDungeon", "You completed the three trials inscribed on the\nstone monument in the Gerudo region.\n\nAfter you collected three of Naboris's Emblems,\nthe monk told you to head to the Divine Beast.\nWhat awaits you there?\n\nGo to the Divine Beast Vah Naboris\nto find out."},
    QuestText{"QL_BalladOfHeroGerudo_ToRemains", "When you reached Divine Beast Vah Naboris,\nyou heard the monk's voice again, and a new\ntrial began!\n\nA phantasm of Thunderblight Ganon, born from\nyour own memories and fears, appeared to\nchallenge your resolve.\n\nComplete the trial using only the tools provided!"},
    QuestText{"QL_BalladOfHeroGoron_Desc", "The scattered One-Hit Obliterator led you to a\nlocation where a stone monument with a map of\ntrials appeared. Kass's song seems related...\n\nOne, stop a titan of molten stone.\nTwo, follow rings of light alone.\nThree, survive lava's fiery fate.\nChampion, trials await!\n\nYou still have three trials to complete."},
    QuestText{"QL_BalladOfHeroGoron_Finish", "You defeated the phantasm of Fireblight\nGanon, which was born from your own\nmemories and fears.\n\nKass's composition, entitled Champion Daruk's\nSong, was so true and moving that it allowed\nyou to visualize a memory from 100 years ago.\n\nBy conquering the trial, your sacred power has\nincreased and Daruk's Protection has become\nmore efficient than ever."},
    QuestText{"QL_BalladOfHeroGoron_Name", "EX Champion Daruk's Song"},
    QuestText{"QL_BalladOfHeroGoron_Seek1stDungeon", "The scattered One-Hit Obliterator led you to a\nlocation where a stone monument with a map of\ntrials appeared. Kass's song seems related...\n\nOne, stop a titan of molten stone.\nTwo, follow rings of light alone.\nThree, survive lava's fiery fate.\nChampion, trials await!\n\nYou still have two trials to complete."},
    QuestText{"QL_BalladOfHeroGoron_Seek2ndDungeon", "The scattered One-Hit Obliterator led you to a\nlocation where a stone monument with a map of\ntrials appeared. Kass's song seems related...\n\nOne, stop a titan of molten stone.\nTwo, follow rings of light alone.\nThree, survive lava's fiery fate.\nChampion, trials await!\n\nYou still have one trial to complete."},
    QuestText{"QL_BalladOfHeroGoron_Seek3rdDungeon", "You completed the three trials inscribed on the\nstone monument in the Eldin region.\n\nAfter you collected three of Rudania's Emblems,\nthe monk told you to head to the Divine Beast.\nWhat awaits you there?\n\nGo to the Divine Beast Vah Rudania\nto find out."},
    QuestText{"QL_BalladOfHeroGoron_ToRemains", "When you reached Divine Beast Vah Rudania,\nyou heard the monk's voice again, and a new\ntrial began!\n\nA phantasm of Fireblight Ganon, born from\nyour own memories and fears, appeared to\nchallenge your resolve.\n\nComplete the trial using only the tools provided!"},
    QuestText{"QL_BalladOfHeroRito_Desc", "The scattered One-Hit Obliterator led you to a\nlocation where a stone monument with a map of\ntrials appeared. Kass's song seems related...\n\nOne, shoot the flame dragon's horn.\nTwo, race down a peak rings adorn.\nThree, shoot four targets to win.\nChampion, the trials begin!\n\nYou still have three trials to complete."},
    QuestText{"QL_BalladOfHeroRito_Finish", "You defeated the phantasm of Windblight\nGanon, which was born from your own\nmemories and fears.\n\nKass's composition, entitled Champion Revali's\nSong, was so true and moving that it allowed\nyou to visualize a memory from 100 years ago.\n\nBy conquering the trial, your sacred power has\nincreased and Revali's Gale has become\nmore efficient than ever."},
    QuestText{"QL_BalladOfHeroRito_Name", "EX Champion Revali's Song"},
    QuestText{"QL_BalladOfHeroRito_Seek1stDungeon", "The scattered One-Hit Obliterator led you to a\nlocation where a stone monument with a map of\ntrials appeared. Kass's song seems related...\n\nOne, shoot the flame dragon's horn.\nTwo, race down a peak rings adorn.\nThree, shoot four targets to win.\nChampion, the trials begin!\n\nYou still have two trials to complete."},
    QuestText{"QL_BalladOfHeroRito_Seek2ndDungeon", "The scattered One-Hit Obliterator led you to a\nlocation where a stone monument with a map of\ntrials appeared. Kass's song seems related...\n\nOne, shoot the flame dragon's horn.\nTwo, race down a peak rings adorn.\nThree, shoot four targets to win.\nChampion, the trials begin!\n\nYou still have one trial to complete."},
    QuestText{"QL_BalladOfHeroRito_Seek3rdDungeon", "You completed the three trials inscribed on the\nstone monument in the Hebra region.\n\nAfter you collected three of Medoh's Emblems,\nthe monk told you to head to the Divine Beast.\nWhat awaits you there?\n\nGo to the Divine Beast Vah Medoh to find out."},
    QuestText{"QL_BalladOfHeroRito_ToRemains", "When you reached Divine Beast Vah Medoh,\nyou heard the monk's voice again, and a new\ntrial began!\n\nA phantasm of Windblight Ganon, born from\nyour own memories and fears, appeared to\nchallenge your resolve.\n\nComplete the trial using only the tools provided!"},
    QuestText{"QL_BalladOfHeroZora_Desc", "The scattered One-Hit Obliterator led you to a\nlocation where a stone monument with a map of\ntrials appeared. Kass's song seems related...\n\nOne, find what the light's path shows.\nTwo, conquer the ancient foes.\nThree, chase rings of the waterfall.\nChampion, the trials call!\n\nYou still have three trials to complete."},
    QuestText{"QL_BalladOfHeroZora_Finish", "You defeated the phantasm of Waterblight\nGanon, which was born from your own\nmemories and fears.\n\nKass's composition, entitled Champion Mipha's\nSong, was so true and moving that it allowed\nyou to visualize a memory from 100 years ago.\n\nBy conquering the trial, your sacred power has\nincreased and Mipha's Grace has become\nmore efficient than ever."},
    QuestText{"QL_BalladOfHeroZora_Name", "EX Champion Mipha's Song"},
    QuestText{"QL_BalladOfHeroZora_Seek1stDungeon", "The scattered One-Hit Obliterator led you to a\nlocation where a stone monument with a map of\ntrials appeared. Kass's song seems related...\n\nOne, find what the light's path shows.\nTwo, conquer the ancient foes.\nThree, chase rings of the waterfall.\nChampion, the trials call!\n\nYou still have two trials to complete."},
    QuestText{"QL_BalladOfHeroZora_Seek2ndDungeon", "The scattered One-Hit Obliterator led you to a\nlocation where a stone monument with a map of\ntrials appeared. Kass's song seems related...\n\nOne, find what the light's path shows.\nTwo, conquer the ancient foes.\nThree, chase rings of the waterfall.\nChampion, the trials call!\n\nYou still have one trial to complete."},
    QuestText{"QL_BalladOfHeroZora_Seek3rdDungeon", "You completed the three trials inscribed on the\nstone monument in the Lanayru region.\n\nAfter you collected three of Ruta's Emblems,\nthe monk told you to head to the Divine Beast.\nWhat awaits you there?\n\nGo to the Divine Beast Vah Ruta to find out."},
    QuestText{"QL_BalladOfHeroZora_ToRemains", "When you reached Divine Beast Vah Ruta,\nyou heard the monk's voice again, and a\nnew trial began!\n\nA phantasm of Waterblight Ganon, born from\nyour own memories and fears, appeared to\nchallenge your resolve.\n\nComplete the trial using only the tools provided!"},
    QuestText{"QL_BalladOfHeroes_Desc", "Zelda's voice spoke to you...\n\nShe said that because you have tamed all\nfour Divine Beasts, you can now unlock\nthe powerful force hidden within.\n\nHead to the Shrine of Resurrection and\nreturn the Sheikah Slate to its terminal."},
    QuestText{"QL_BalladOfHeroes_Finish", "The power within prevailed! You proved your\nworthiness to Monk Maz Koshia by completing\nall of the Divine Beast Tamer's Trials. Your gift,\nthe Master Cycle Zero, can be found with your\nRunes. After the trial, you met with Kass,\nwho sang the completed Champions' Ballad\nfor you. The song helped you recall the distant\nday you were appointed as a Champion..."},
    QuestText{"QL_BalladOfHeroes_Name", "EX The Champions' Ballad"},
    QuestText{"QL_BalladOfHeroes_Retire", "After returning the Sheikah Slate to the terminal\nin the Shrine of Resurrection, a mysterious\nweapon appeared out of nowhere.\n\nYou must use it to defeat all monsters at\nfour locations within the Great Plateau.\n\nThe trial will begin again once you take hold\nof the weapon that has returned to the\nShrine of Resurrection."},
    QuestText{"QL_BalladOfHeroes_Retire_Dungeon04", "After returning the Sheikah Slate to the terminal\nin the Shrine of Resurrection, a mysterious\nweapon appeared out of nowhere.\n\nUsing it, you were able to defeat all monsters at\nfour locations within the Great Plateau. Now you\nmust also conquer the Shrines that appeared.\n\nThe trial will begin again once you take hold\nof the weapon that has returned to the\nShrine of Resurrection."},
    QuestText{"QL_BalladOfHeroes_Step01", "After returning the Sheikah Slate to the terminal\nin the Shrine of Resurrection, a mysterious\nweapon appeared out of nowhere.\n\nYou must use it to defeat all monsters at\nfour locations within the Great Plateau.\n\nThe trial will begin once you take hold\nof the weapon."},
    QuestText{"QL_BalladOfHeroes_Step02", "The One-Hit Obliterator, as the name suggests,\ncan defeat enemies in one-hit. However,\nthe wielder will also be defeated in one hit.\nDefeat the monsters at the locations marked\non the map within the Great Plateau.\n\nIf you wish to quit this trial, simply leave the\nGreat Plateau. The weapon will leave your\nhands and return to the Shrine of Resurrection.\n\nThere are four monster bases remaining."},
    QuestText{"QL_BalladOfHeroes_Step02_Dungeon01", "The One-Hit Obliterator, as the name suggests,\ncan defeat enemies in one hit. However,\nthe wielder will also be defeated in one hit.\nDefeat the monsters at the locations marked\non the map. If you wish to quit this trial,\nsimply leave the Great Plateau. The weapon\nwill leave your hands and return to the\nShrine of Resurrection.\n\nThere are three monster bases remaining.\nConquer each Shrine that appears."},
    QuestText{"QL_BalladOfHeroes_Step02_Dungeon02", "The One-Hit Obliterator, as the name suggests,\ncan defeat enemies in one hit. However,\nthe wielder will also be defeated in one hit.\nDefeat the monsters at the locations marked\non the map. If you wish to quit this trial,\nsimply leave the Great Plateau. The weapon\nwill leave your hands and return to the\nShrine of Resurrection.\n\nThere are two monster bases remaining.\nConquer each Shrine that appears."},
    QuestText{"QL_BalladOfHeroes_Step02_Dungeon03", "The One-Hit Obliterator, as the name suggests,\ncan defeat enemies in one hit. However,\nthe wielder will also be defeated in one hit.\nDefeat the monsters at the locations marked\non the map. If you wish to quit this trial,\nsimply leave the Great Plateau. The weapon\nwill leave your hands and return to the\nShrine of Resurrection.\n\nThere is one monster base remaining.\nConquer each Shrine that appears."},
    QuestText{"QL_BalladOfHeroes_Step03", "You completed the trials of the Great Plateau!\nAfter conquering the last shrine, the One-Hit\nObliterator split into four glowing orbs and\nscattered to different parts of Hyrule.\n\nThere seems to be more to this trial...\nWhat challenges await?\n\nGo to the areas marked on the map.\nLocations remaining:"},
    QuestText{"QL_BalladOfHeroes_Step04", "In a realm of memory, you defeated the powerful\nPhantom Ganons of the four Divine Beasts.\nYou have also completed the four trials\ninscribed on the stone monument.\n\nBut this trial is far from over.\n\nThe door to the final trial in the Shrine of \nResurrection has opened. Return there\nonce more."},
    QuestText{"QL_BalladOfHeroes_Step05", "When you returned the Sheikah Slate to the\nterminal at the Shrine of Resurrection,\nthe room shook and descended.\n\nThe shrine itself must have been designed to\nplay a part in the trial... Once you reached the\nunderground, an enormous space was revealed.\n\nConquer the labyrinth."},
    QuestText{"QL_BalladOfHeroes_Step06", "You reached the deepest area of the\ntrial's labyrinth!\n\nBefore you could report your completion of the\ntrial to Monk Maz Koshia, he rose before you\nand the final trial started.\n\nDisplay your power by fighting Monk Maz Koshia\nand proving you are worthy of mastering\na Divine Beast."},
    QuestText{"QL_BalladOfHeroes_Step2_Dungeon4", "The One-Hit Obliterator, as the name suggests,\ncan defeat enemies in one hit. However,\nthe wielder will also be defeated in one hit.\n\nIf you wish to quit this trial, simply leave the\nGreat Plateau. The weapon will leave your\nhands and return to the Shrine of Resurrection.\n\nYou have defeated all of the monster bases.\nConquer each Shrine that appears."},
    QuestText{"QL_BloodyMoonRelief_Desc", "\"When the moon bleeds and the fiends\nare reborn / The monks will invite you\nas they have sworn.\n\nBut first you must stand on the pedestal\nbare / With nothing between you and\nthe night air.\"\n\nYou heard this ancient song from Kass.\nPerhaps a shrine waits beyond the\npuzzle of these words..."},
    QuestText{"QL_BloodyMoonRelief_Name", "Under a Red Moon"},
    QuestText{"QL_BloodyMoonRelief_Step1", "\"When the moon bleeds and the fiends\nare reborn / The monks will invite you\nas they have sworn.\n\nBut first you must stand on the pedestal\nbare / With nothing between you and\nthe night air.\"\n\nAfter you took off all your clothing and stood on\ntop of the pedestal on the night of the blood\nmoon, an ancient shrine appeared."},
    QuestText{"QL_Bottle_Mes_Desc", "Follow the letter down the river without losing\nsight of it, and find out who receives it. The\nletter's casing is fragile, so take care when\npursuing it downstream.\n\nIf you lose sight of the letter, return to Finley\nto try again."},
    QuestText{"QL_Bottle_Mes_Finish", "Sasan arrived safely at Zora's Domain and met\nwith Finley. Your part in the matter is concluded,\nthough it remains to be seen whether Sasan\ncan put on the muscle Finley hopes for."},
    QuestText{"QL_Bottle_Mes_Name", "Special Delivery"},
    QuestText{"QL_Bottle_Mes_Step10", "The letter's casing is fragile, so keep a close\neye on it.\n\nIf you lose sight of the letter, return to Finley\nto try again."},
    QuestText{"QL_Bottle_Mes_Step30", "It turns out that Sasan picked up the message.\nHe's heading to Zora's Domain to meet\nFinley now.\n\nIf you want to see what happens, you should\nget to Zora's Domain too..."},
    QuestText{"QL_Carnivorous_Boy_Desc", "Trott, a stable hand on the edge of the plain,\nis in the doldrums. The only thing that could\nlift his spirits is some raw gourmet meat."},
    QuestText{"QL_Carnivorous_Boy_Finish", "Trott, a stable hand at the Outskirt Stable,\nfound color returning to his cheeks for the first\ntime in a while after a meaty dinner.\n\nFrom now on, he'll pay you 100 rupees out of\nhis own pocket each time you bring him some\nraw gourmet meat."},
    QuestText{"QL_Carnivorous_Boy_Name", "A Rare Find"},
    QuestText{"QL_CarryingBlueFireEXMini_Carry", "The blue flame in the furnace is now\npowering the Hateno Ancient Tech Lab's\nGuidance Stone.\n\nReport to the director so that she can repair\nyour Sheikah Slate."},
    QuestText{"QL_CarryingBlueFireEXMini_Desc", "According to Impa, the Sheikah Slate that\nZelda left to guide you is incomplete.\n\nThe director at the Hateno Ancient Tech Lab\nin Hateno Village may know a way to restore\nthe Sheikah Slate's missing components.\n\nUse the map to find the location of the\nHateno Ancient Tech Lab and its director."},
    QuestText{"QL_CarryingBlueFireEXMini_Finish", "You let Impa know that the basic runes of the\nSheikah Slate have been restored.\n\nShe told you that the pictures in the album are\nZelda's memories from 100 years ago.\n\nVisit the various spots shown in the images\nZelda left behind to recall your own memories\nfrom that era!"},
    QuestText{"QL_CarryingBlueFireEXMini_Fired", "Purah has fixed the Sheikah Slate, restoring\nthe last of its basic runes from 100 years ago.\n\nSnap an image of Purah using the Camera rune!"},
    QuestText{"QL_CarryingBlueFireEXMini_Name", "Locked Mementos"},
    QuestText{"QL_CarryingBlueFireEXMini_Permit", "The Hateno Ancient Tech Lab's director can't\nfix the Sheikah Slate until the Guidance Stone\nis operational again. The only way to power\nthe Guidance Stone is to light the furnace on\nthe outer wall of the tech lab with a blue flame.\n\nCarry the blue flame from the ancient furnace\nin Hateno Village to the tech lab, and use it to\nlight the lab's furnace."},
    QuestText{"QL_CarryingBlueFireEXMini_Repaired", "You proved the Camera works again by\ncapturing an image of Purah!\n\nAccording to Purah, the album already has\npictures from the past in it.\n\nWhere could these have come from? Impa in\nKakariko Village may have the answer."},
    QuestText{"QL_Cliff_Maze_Desc", "Upon reaching the ruins in northeast\nTabantha Tundra, you were greeted by a\nmysterious voice.\n\nIt told you that you would receive a blessing if\nyou were able to make it past the maze."},
    QuestText{"QL_Cliff_Maze_Finish", "A cliff maze built by someone.\n\nA shrine, containing a blessing, waited at the\nheart of the challenge."},
    QuestText{"QL_Cliff_Maze_Name", "Trial on the Cliff"},
    QuestText{"QL_CompleteDungeon_Desc", "You've conquered all of the shrine trials.\nThe monks have prepared a gift for just such\nan occasion.\n\nHead to the Forgotten Temple where the\noldest statue of the Goddess stands to see\nwhat they have left for you there."},
    QuestText{"QL_CompleteDungeon_Finish", "You've accepted the gift from the monks at the\nForgotten Temple.\n\nInside, you found a special green outfit made\nespecially for the hero who braved the\nwilderness alone.\n\nWill donning this outfit help you to become\nthe land's true hero?"},
    QuestText{"QL_CompleteDungeon_Name", "A Gift from the Monks"},
    QuestText{"QL_CursedStatue_Desc", "\"When a dark light resides in the cursed\nstatue's eyes, pierce its gaze to purge the seal\nfrom the shrine.\"\n\nYou heard this from Calip, the self-proclaimed\narchaeologist. Solving the ancient song's riddle\nwill reveal the hidden shrine."},
    QuestText{"QL_CursedStatue_Game", "\"When a dark light resides in the cursed\nstatue's eyes, pierce its gaze to purge the seal\nfrom the shrine.\"\n\nYou fired an arrow into the glowing eyes of the\nstatue, and the ancient shrine was revealed."},
    QuestText{"QL_CursedStatue_Name", "The Cursed Statue"},
    QuestText{"QL_DarkWoods_Desc", "When you arrived in the ruins shrouded in\ndarkness, a strange voice spoke out to you.\n\nIt would seem that a shrine is hidden\nsomewhere within the ruins, though it may prove\nchallenging to search a place that is pitch black,\neven during the day."},
    QuestText{"QL_DarkWoods_Finish", "Someone built this challenge within the\nThyphlo Ruins.\n\nWhen you stole the object from the Hinox\nhidden in the depths of the ruins and placed\nit on the pedestal, a shrine appeared!"},
    QuestText{"QL_DarkWoods_Name", "Shrouded Shrine"},
    QuestText{"QL_Desert_Maze_Desc", "As you advanced through the Gerudo Desert\nand arrived in front of the suspicious ruins\nresting at the foot of Daval Peak, you heard\na voice.\n\nIt seems that, if you're able to make it through\nthis labyrinth, you will receive a blessing."},
    QuestText{"QL_Desert_Maze_Finish", "A labyrinth built at the foot of Daval Peak...\n\nThere was a shrine waiting for you\nat the end of the labyrinth."},
    QuestText{"QL_Desert_Maze_Name", "The Desert Labyrinth"},
    QuestText{"QL_DokuroEye_Desc", "Jerrin told you of an ancient shrine atop\nthe left eye of Skull Lake.\n\nHowever, the sheer cliffs surrounding it may\nmake it next to impossible to reach..."},
    QuestText{"QL_DokuroEye_Finish", "You gained entry into the ancient shrine atop\nthe left eye of Skull Lake.\n\nYou understand now what Jerrin meant when\nshe said that the real trial was getting there."},
    QuestText{"QL_DokuroEye_Name", "The Skull's Eye"},
    QuestText{"QL_DontDamageFlower_Desc", "Magda planted flowers all around the\nancient shrine.\n\nProceed with care so you don't damage the\nflowers."},
    QuestText{"QL_DontDamageFlower_Finish", "You reached the shrine amidst the flowers\nthat Magda had planted.\n\nTry not to step on any flowers from here on out!"},
    QuestText{"QL_DontDamageFlower_Name", "Watch Out for the Flowers"},
    QuestText{"QL_Drag_Hero_Desc", "You heard of a man at the Kara Kara Bazaar\nwho found a way to sneak into Gerudo Town,\na place men are forbidden from entering.\n\nTry and locate some people who know\nhis whereabouts."},
    QuestText{"QL_Drag_Hero_Finish", "You snuck into Gerudo Town successfully!\n\nYou were able to fool the town guards by\ndisguising yourself in a Gerudo outfit."},
    QuestText{"QL_Drag_Hero_Name", "Forbidden City Entry"},
    QuestText{"QL_Drag_Hero_Step1", "You were able to find the man who snuck into\nGerudo Town, and you got a Gerudo outfit\nfrom him.\n\nPut that on and you'll be able to pass\nfor a woman while you're wearing it..."},
    QuestText{"QL_Electric_Relic_Arrival", "You've arrived in the thieves' hideout! You can\nsense many people waiting within—you would\nbe at a disadvantage if a fight were to\nbreak out.\n\nSneak into the hideout, and recover the\nGerudo chief's heirloom."},
    QuestText{"QL_Electric_Relic_Defeat", "You defeated the Thunderblight Ganon\nlurking deep within the\nDivine Beast Vah Naboris!\n\nUrbosa's Divine Beast Vah Naboris has\ntaken up a position in the eastern region of\nthe Gerudo Desert.\n\nMake your way back to Gerudo Town, and\nreport to the chief of the Gerudo, Riju!"},
    QuestText{"QL_Electric_Relic_Deliver", "At last you are ready to take on the\nDivine Beast Vah Naboris. Head for the\nlookout post where Riju is waiting for you.\n\nRiju has told you that a fight with the Divine\nBeast will go much more smoothly for one\nwho knows how to sand-seal surf."},
    QuestText{"QL_Electric_Relic_Desc", "The leader of the Gerudo, Lady Riju, asked for\nyour help in conquering\nDivine Beast Vah Naboris.\n\nBefore you can confront the Divine Beast, the\nGerudo need help recovering the chief's\nheirloom, which has been stolen. Captain Teake\nin the soldiers' barracks has the latest\ninformation on the thieves."},
    QuestText{"QL_Electric_Relic_Finish", "You've reported to Riju that you've conquered\nDivine Beast Vah Naboris!\n\nYou've learned how to use Urbosa's Fury,\none of the Champions' blessings."},
    QuestText{"QL_Electric_Relic_GetBack", "You retrieved the chief's heirloom from the\nthieves' leader!\n\nIt's time to head back to Gerudo Town\nand return the heirloom to Riju!"},
    QuestText{"QL_Electric_Relic_Invasion", "You succeeded in taking out all four of the\nDivine Beast Vah Naboris's feet, stopping\nits movement!\n\nContinue your quest by entering Naboris."},
    QuestText{"QL_Electric_Relic_Name", "Divine Beast Vah Naboris"},
    QuestText{"QL_Electric_Relic_Search", "After speaking with Captain Teake, you learned\nthat the thieves are hiding out in Karusa Valley,\nbut the hideout itself has not been scouted by\nany of the soldiers.\n\nGather additional information from the soldiers,\nand then head for the thieves' hideout."},
    QuestText{"QL_Electric_Relic_Strategy", "The fight with the Divine Beast Vah Naboris\nhas begun. Attack the feet of the Divine Beast\nusing bomb arrows to stop its movement.\n\nIt seems that staying close to Riju will nullify the\neffects of the Divine Beast's powerful lightning\nattacks."},
    QuestText{"QL_FairyFountain_Desc", "Pikango really wants to see the entrancing\nGreat Fairy Fountain behind Kakariko Village,\nbut all of his efforts to search for it have been\nstymied.\n\nIf you find the fountain, surely Pikango would\nappreciate proof of its location."},
    QuestText{"QL_FairyFountain_Finish", "You took a picture of the Great Fairy Fountain\nPikango was looking for and showed it to him."},
    QuestText{"QL_FairyFountain_Name", "Find the Fairy Fountain"},
    QuestText{"QL_FindDungeon_1stClear", "The old man explained that there are a total of\nfour shrines on the plateau. He said that he will\ngive you the paraglider once you have acquired\nthe Spirit Orb from all of the shrines.\nHe told you to survey the plateau from the top\nof the tower to find the remaining shrines. He\nalso pointed out that you can use your\nSheikah Slate if you need to travel quickly."},
    QuestText{"QL_FindDungeon_AllClear", "After you acquired the Spirit Orbs from the\nshrines, the old man told you that he'll be\nwaiting in the place centered amid the four \nshrines, before mysteriously disappearing..."},
    QuestText{"QL_FindDungeon_Desc", "After your descent from the tower, the old man\ntold you that the kingdom of Hyrule was\ndestroyed 100 years ago by Calamity Ganon.\n\nYou heard a voice coming from Hyrule Castle,\nbut you cannot reach it unless you leave the\nplateau using the paraglider.\n\nThe old man said that he will give you the\nparaglider in exchange for the treasure that lies\nwithin a hidden location somewhere..."},
    QuestText{"QL_FindDungeon_Finish", "The old man you were talking to informed you\nthat he was King Rhoam. The voice you heard\ncoming from Hyrule Castle was Princess Zelda.\n\nThe princess is trapped inside the castle, which\nis shrouded in Malice, fighting against Ganon...\n\nThe king's ghost left you with one last\ndirective: rescue Princess Zelda and defeat\nGanon. He gave you the paraglider now that\nhis duty is done."},
    QuestText{"QL_FindDungeon_Name", "The Isolated Plateau"},
    QuestText{"QL_Find_4Relic_1stClear", "There are four Divine Beasts:\n-The Divine Beast Vah Rudania of the Gorons\n-The Divine Beast Vah Medoh of the Rito\n-The Divine Beast Vah Ruta of the Zora\n-The Divine Beast Vah Naboris of the Gerudo\n\nThe elder of each race should know more.\n\nYou've beaten the phantom of Ganon haunting\none of the Divine Beasts. There are three left."},
    QuestText{"QL_Find_4Relic_2ndClear", "There are four Divine Beasts:\n-The Divine Beast Vah Rudania of the Gorons\n-The Divine Beast Vah Medoh of the Rito\n-The Divine Beast Vah Ruta of the Zora\n-The Divine Beast Vah Naboris of the Gerudo\n\nThe elder of each race should know more.\n\nYou've beaten the phantoms of Ganon haunting\ntwo of the Divine Beasts. There are two left."},
    QuestText{"QL_Find_4Relic_3rdClear", "There are four Divine Beasts:\n-The Divine Beast Vah Rudania of the Gorons\n-The Divine Beast Vah Medoh of the Rito\n-The Divine Beast Vah Ruta of the Zora\n-The Divine Beast Vah Naboris of the Gerudo\n\nThe elder of each race should know more.\n\nYou've beaten the phantoms of Ganon haunting\nthree of the Divine Beasts. There is one left."},
    QuestText{"QL_Find_4Relic_4thClear", "There are four Divine Beasts:\n-The Divine Beast Vah Rudania of the Gorons\n-The Divine Beast Vah Medoh of the Rito\n-The Divine Beast Vah Ruta of the Zora\n-The Divine Beast Vah Naboris of the Gerudo\n\nYou've reclaimed the four Divine Beasts\nby defeating the four Ganon phantoms\nhaunting them. You should let Impa know\nof your success."},
    QuestText{"QL_Find_4Relic_Desc", "There are four Divine Beasts that must be\nfreed:\n-The Divine Beast Vah Rudania, piloted by\nDaruk of the Gorons\n-The Divine Beast Vah Medoh, piloted by\nRevali of the Rito\n-The Divine Beast Vah Ruta, piloted by\nMipha of the Zora\n-The Divine Beast Vah Naboris, piloted by\nUrbosa of the Gerudo\nEach race's elder should have more details."},
    QuestText{"QL_Find_4Relic_Finish", "There are four Divine Beasts:\n-The Divine Beast Vah Rudania of the Gorons\n-The Divine Beast Vah Medoh of the Rito\n-The Divine Beast Vah Ruta of the Zora\n-The Divine Beast Vah Naboris of the Gerudo\n\nYou've reclaimed the four Divine Beasts\nby defeating the four Ganon phantoms\nhaunting them. You are ready to face Ganon."},
    QuestText{"QL_Find_4Relic_Name", "Free the Divine Beasts"},
    QuestText{"QL_Find_Impa_Desc", "You were tasked with going to Kakariko Village\nto speak with Impa, who will give you more\ndetails on your quest.\n\nDescend from the Great Plateau and head\neast beyond the Dueling Peaks, then follow\nthe road to the north. The blinking dot on your\nSheikah Slate's map will guide the way."},
    QuestText{"QL_Find_Impa_Finish", "Impa, the chief of Kakariko Village, relayed the\ntale of what happened 100 years ago, as well\nas the mission entrusted to you by Princess\nZelda to free the four Divine Beasts.\n\nBut first, it seems that your Sheikah Slate\nis incomplete. Having it fixed at the\nHateno Ancient Tech Lab in Hateno Village\nmay provide more clues to your mission."},
    QuestText{"QL_Find_Impa_Name", "Seek Out Impa"},
    QuestText{"QL_Fire_Relic_Battle", "Sentries now patrol Death Mountain to\neliminate intruders.\n\nAvoid their notice as you lead Yunobo to the\ncannons to drive Divine Beast Vah Rudania\ninto the crater."},
    QuestText{"QL_Fire_Relic_BattlePlaying", "Thanks to Yunobo using Daruk's Protection\nto act as your cannonball, you drove\nDivine Beast Vah Rudania into the crater!\n\nIt is time to enter Divine Beast Vah Rudania\nand bring it to a halt."},
    QuestText{"QL_Fire_Relic_Bridge", "Yunobo used Daruk's Protection to\nact as a cannonball. The Bridge of Eldin\nhas been lowered! \n\nAll you need to do now is to cross\nthe Bridge of Eldin and drive\nDivine Beast Vah Rudania into\nthe crater."},
    QuestText{"QL_Fire_Relic_Desc", "Bludo, Boss of Goron City, wants to challenge\nthe marauding Divine Beast Vah Rudania,\nbut his backache is too severe.\n\nWhat's worse, Yunobo has yet to return from\nthe Abandoned North Mine with the painkillers\nhe was sent to fetch."},
    QuestText{"QL_Fire_Relic_Dungeon", "Defeating Fireblight Ganon freed the spirit of\nDaruk, Champion of the Goron race. He has\npiloted the Divine Beast to the summit of\nDeath Mountain in preparation for the assault\non Ganon.\n\nSeeing this, a relieved Yunobo returned to his\nhome in Goron City. You should go there and\ntell Bludo all that has happened."},
    QuestText{"QL_Fire_Relic_Finished", "You reported your success in restoring the\nDivine Beast Vah Rudania to its true self.\nPeace has finally returned to Goron City.\n\nIn addition, you received the Champion Daruk's\nmight and can now use Daruk's Protection."},
    QuestText{"QL_Fire_Relic_GoDeathMt", "You helped Yunobo fend off monsters at the\nBridge of Eldin before telling him that Bludo's\nplan had been called off.\n\nYou still need to get inside the Divine Beast\nsomehow, though... The best way forward may\nbe to lower the Bridge of Eldin."},
    QuestText{"QL_Fire_Relic_GoGoronCity", "Bludo thanked you for helping Yunobo.\nAfter taking the painkillers, Bludo was about\nto go challenge Divine Beast Vah Rudania,\nbut then his back started hurting again.\nNo one will be challenging the Divine Beast\ntoday, it seems.\n\nYunobo has already gone ahead to the\nBridge of Eldin, so you must meet him there\nto let him know about this change of plans."},
    QuestText{"QL_Fire_Relic_Name", "Divine Beast Vah Rudania"},
    QuestText{"QL_Fire_Relic_NorthMine", "You met Drak in the Abandoned North Mine,\nwho told you that Yunobo left for the vault\ndeep in its reaches. That's the last anyone\nhas seen of Yunobo...\n\nMount a search operation for Yunobo, who was\nheaded for the vault."},
    QuestText{"QL_Fire_Relic_Storage", "You met Yunobo in the Abandoned North Mine.\n\nYunobo hurried back to Goron City to deliver\nthe painkillers Bludo needs for his backache.\n\nYou should go speak to Bludo to collect\nyour reward."},
    QuestText{"QL_FironeMini_GiantHorse_Desc", "Out in the Faron Grasslands, you came upon\nStraia, who is conducting a study on animals of\nthe region. He said he's specifically looking for\nthe rumored giant horse that lives on the\nTaobab Grasslands.\n\nStraia asked you to help with his investigation\ninto the giant horse. After all, how giant could\nit really be?"},
    QuestText{"QL_FironeMini_GiantHorse_Finish", "You captured the giant horse in\nTaobab Grasslands.\n\nGiant was an accurate description, to be sure.\nThis beast could probably trample monsters\nwith ease.\n\nWhen you brought it back to Straia, he was\nvery surprised."},
    QuestText{"QL_FironeMini_GiantHorse_Name", "Hunt for the Giant Horse"},
    QuestText{"QL_FironeMini_HeartPond_Desc", "Wabbin has fallen for a Gerudo woman, but he\ncan't work up the courage to talk to her. He's\nasked that you bring him some blue nightshade\nso that he can have an excuse to speak to her."},
    QuestText{"QL_FironeMini_HeartPond_Finish", "It turns out that while Wabbin was working up\nthe nerve to talk to Perda, she'd been waiting\nfor him to approach her! The confession of\nlove wasn't exactly ideal, but at least the\nsoul mates are both finally talking."},
    QuestText{"QL_FironeMini_HeartPond_GetFlower", "You brought blue nightshade to Wabbin, who\nhas fallen for a Gerudo woman named Perda—\na woman he's never spoken to. He hoped the\nblue nightshade would help him break the ice,\nbut he's so nervous he can't even move.\n\nWabbin has asked that you give the\nblue nightshade to the woman on his behalf."},
    QuestText{"QL_FironeMini_HeartPond_Name", "A Gift of Nightshade"},
    QuestText{"QL_FironeMini_HeartPond_PresentFlower", "You gave Perda the blue nightshade on\nWabbin's behalf since his nervousness had\nrendered him unable to move."},
    QuestText{"QL_FironeMini_HorseEnemy_Desc", "Faron Grasslands is known for its horses.\n\nHowever, a gang of heathens has taken over\nthe area lately. This has caused Perosa and the\nother residents some strife.\n\nIf someone were willing to take on this group of\nhoodlums, it would definitely cheer up Perosa."},
    QuestText{"QL_FironeMini_HorseEnemy_Exterminate", "You defeated all the gang members causing\ntrouble in the grasslands!\n\nPerosa will surely be happy to hear the news!"},
    QuestText{"QL_FironeMini_HorseEnemy_Finish", "You defeated all the gang members causing\ntrouble in the grasslands!\n\nPerosa was so happy with the news, she gave\nyou an endura carrot as a reward for your\nhard work.\n\nIt's said that horses are quite fond of those..."},
    QuestText{"QL_FironeMini_HorseEnemy_Name", "The Horseback Hoodlums"},
    QuestText{"QL_FironeMini_TerribleThunder_Desc", "Cima is feeling really gloomy, likely because of\nall the lightning.\n\nLakeside Stable seems to attract lightning\nstrikes constantly, and Cima has asked you to\nfigure out why."},
    QuestText{"QL_FironeMini_TerribleThunder_Finish", "Cima seems relieved to hear the news, though\nit sounds like she still hates all the noise a\nthunderstorm makes."},
    QuestText{"QL_FironeMini_TerribleThunder_Name", "Thunder Magnet"},
    QuestText{"QL_FironeMini_TerribleThunder_Remove", "It turns out the lightning was drawn to\nLakeside Stable because of a metal weapon\nstuck on top of the building!\n\nHead back to Cima, and let her know what\nwas going on."},
    QuestText{"QL_FirstOhenro_Desc", "You've been recruited to watch over Oaki's\nfirst trial.\n\nFollow Oaki without being seen."},
    QuestText{"QL_FirstOhenro_Finish", "Oaki arrived safely at the destination and\nsucceeded in the first trial!\n\nIt turns out the destination was one of the\nshrines dotting Hyrule!"},
    QuestText{"QL_FirstOhenro_Name", "The Lost Pilgrimage"},
    QuestText{"QL_FirstOhenro_Step1", "Oaki has set off to face the trial alone.\n\nFollow along without being seen. Take care to\navoid being discovered!"},
    QuestText{"QL_FirstOhenro_Step2", "Oaki safely arrived at the destination.\n\nYou stayed out of sight and got to see Oaki's\nsuccess!"},
    QuestText{"QL_FirstTower_Desc", "From out of nowhere, you hear a woman's\nvoice speak to you... She instructs you to head\nto the marker displayed on the Sheikah Slate.\n\nThe slate is both alien and somehow familiar\nto you... You find that you can access its\nmap by pressing the  button."},
    QuestText{"QL_FirstTower_Finish", "When you inserted your Sheikah Slate in the\npedestal marked on the map, a giant tower\nerupted upward from the ground, carrying you\nhigh into the air.\n\nFrom Hyrule Castle, off in the distance, you hear\nthe woman's voice speaking to you again..."},
    QuestText{"QL_FirstTower_Name", "Follow the Sheikah Slate"},
    QuestText{"QL_FourJewel_Desc", "When you arrived at the Thundra Plateau, a\nfierce storm blowing around you, a voice spoke.\n\nThe voice said that a trial would appear once\nfour spirits were set in their proper places."},
    QuestText{"QL_FourJewel_Finish", "You set the four spirits in their proper places\nbased on the diagrams on the stone pillars.\n\nWhen this was done, a shrine appeared in the\nmiddle of the Thundra Plateau!"},
    QuestText{"QL_FourJewel_Name", "Trial of Thunder"},
    QuestText{"QL_Gaman_Desc", "The Goron Blood Brothers have challenged\nyou to a test of will.\n\nThe rules are simple... The challenger who can\nhandle the intense heat within the ring for the\nlongest without leaving the ring is the winner.\n\nThey say that's all there is to it, but..."},
    QuestText{"QL_Gaman_Finish", "After you endured the heated test,\na shrine suddenly appeared.\n\n\"So sweaty... Brother...\"\n-Kabetta\n\nOh, that's all from Kabetta?\nThat's too bad, brother..."},
    QuestText{"QL_Gaman_Name", "Test of Will"},
    QuestText{"QL_Gaman_Step1", "\"A true Goron has a barrel for a chest and a\nheart the size of his biceps.\n\nGearing up accordingly and having your hearts\nfilled up before competing is key, brother!\"\n-Bayge"},
    QuestText{"QL_Gaman_Step1_2", "一回目のガマンくらべに成功した"},
    QuestText{"QL_Gaman_Step1_2_1", "一回目のガマンくらべに成功した"},
    QuestText{"QL_Gaman_Step1_2_10", "一回目のガマンくらべに成功した"},
    QuestText{"QL_Gaman_Step1_2_11", "一回目のガマンくらべに成功した"},
    QuestText{"QL_Gaman_Step1_2_12", "一回目のガマンくらべに成功した"},
    QuestText{"QL_Gaman_Step1_2_13", "一回目のガマンくらべに成功した"},
    QuestText{"QL_Gaman_Step1_2_2", "一回目のガマンくらべに成功した"},
    QuestText{"QL_Gaman_Step1_2_3", "一回目のガマンくらべに成功した"},
    QuestText{"QL_Gaman_Step1_2_4", "一回目のガマンくらべに成功した"},
    QuestText{"QL_Gaman_Step1_2_5", "一回目のガマンくらべに成功した"},
    QuestText{"QL_Gaman_Step1_2_6", "一回目のガマンくらべに成功した"},
    QuestText{"QL_Gaman_Step1_2_7", "一回目のガマンくらべに成功した"},
    QuestText{"QL_Gaman_Step1_2_8", "一回目のガマンくらべに成功した"},
    QuestText{"QL_Gaman_Step1_2_9", "一回目のガマンくらべに成功した"},
    QuestText{"QL_Gaman_Step1_2_Failed", "一回目のガマンくらべを失敗した"},
    QuestText{"QL_Gaman_Step1_2_Successed", "You've been challenged to an even hotter\ntest of will.\n\nThe three brothers admitted defeat before, but\nthis time you'll have to make sure you've got\nsome serious heat resistance if you want\nto match their will in the scorching ring."},
    QuestText{"QL_Gaman_Step2", "\"A true Goron needs mental fortitude,\nphysical fortitude, and spiritual fortitude.\n\nThis next test is beyond anything anyone\nhas ever attempted. You've worked out how\nto protect against heat...right, brother?\"\n-Heehl"},
    QuestText{"QL_GanonQuest_Desc", "The ghost of King Rhoam told you that\nHyrule is on the brink of annihilation.\n\nPrincess Zelda is currently fighting to contain\nCalamity Ganon inside Hyrule Castle, but her\npower cannot keep him at bay forever.\nEventually, Ganon will regain his full\nstrength and destroy the world.\n\nYour ultimate task is to aid Princess Zelda in\ndefeating Ganon before that can happen."},
    QuestText{"QL_GanonQuest_Finished", "不要？\nガノンの形態によってステップを分けた方がいいかも"},
    QuestText{"QL_GanonQuest_Name", "Destroy Ganon"},
    QuestText{"QL_GerudoMiniJewel_Desc", "Isha, the jeweler, is in a bind. She ran out of\nthe flint she needs to keep making her\naccessories. She says that she can reopen her\nstore if you bring her 10 pieces of flint."},
    QuestText{"QL_GerudoMiniJewel_Finished", "Isha, the jeweler, ran out of flint and was feeling\npretty worried. But since you brought her 10\npieces, she is able to reopen her store."},
    QuestText{"QL_GerudoMiniJewel_Name", "Tools of the Trade"},
    QuestText{"QL_Gerudo_CarryIce_Desc", "A Gerudo named Pokki has collapsed in front\nof the ancient shrine. You'll have to find a way\nto revive her if you want to get inside. She was\nbarely coherent, but it sounded like she was\nmuttering about wanting to drink something\ncalled Noble Pursuit."},
    QuestText{"QL_Gerudo_CarryIce_Gerudo_CarryIce_Delivered", "You delivered the ice to the owner of\nthe canteen.\n\nShe's now able to make ice-cold Noble Pursuits.\nShe's asked that you go back to Pokki and let\nher know that a drink is waiting for her.\nPokki had collapsed in front of the shrine."},
    QuestText{"QL_Gerudo_CarryIce_Gerudo_CarryIce_Finished", "When you told Pokki about the ice-cold Noble\nPursuit, she flew off in the direction of the\nGerudo canteen.\n\nYou can enter the shrine anytime you want."},
    QuestText{"QL_Gerudo_CarryIce_Gerudo_CarryIce_Get", "You got Anche to give you some ice!\n\nYou now have to carry the ice back to Furosa,\nwho waits at the exit of the ruins north of town.\nWith the blazing heat of the desert, it'll be a \nchallenge to get back without the ice melting."},
    QuestText{"QL_Gerudo_CarryIce_Gerudo_CarryIce_bar", "Noble Pursuit is a famous drink from the\nGerudo canteen. Unfortunately, it can't be\nmade right now because they're all out of ice.\n\nYou'll need to go to the icehouse north of\nGerudo Town and ask Anche to give you some\nice. You can only get Anche's help while it's\nbright out, though."},
    QuestText{"QL_Gerudo_CarryIce_Name", "The Perfect Drink"},
    QuestText{"QL_Gerudo_Ch_FindingValetta_Desc", "Barta has disappeared again. She headed\nsouth in search of leviathan bones but never\ncame back. Not only is the area home to\nMolduga, but it's also known for extreme heat.\nYou'll need special gear, or you'll be in \ndanger. Use your map to search for Barta."},
    QuestText{"QL_Gerudo_Ch_FindingValetta_Finish", "Barta seems to have made it back to \nGerudo Town in one piece.\n\nBut it sounds like Liana really chewed Barta out\nfor making her worry. Maybe she'll lay low for a\nlittle while."},
    QuestText{"QL_Gerudo_Ch_FindingValetta_Name", "The Search for Barta"},
    QuestText{"QL_Gerudo_Ch_FindingValetta_Step1", "You found Barta collapsed in the desert.\n\nShe just keeps muttering, \"A hearty durian,\na hearty durian,\" over and over again,\ndeliriously.\n\n...Seems like she really wants to eat a\nhearty durian."},
    QuestText{"QL_Gerudo_Ch_FindingValetta_Step2", "You fed Barta a hearty durian after finding\nher collapsed in the desert.\n\nShe seemed much better, but once you told her\nof Liana's anger, she dashed off back to\nGerudo Town. Just in case, you should let Liana\nknow that Barta is OK."},
    QuestText{"QL_Gerudo_Ch_Helmet_Desc", "The Thunder Helm has been passed down as\na prized treasure of the Gerudo since Urbosa's\ntime. It doesn't seem like they'll just give it to\nyou, but if you're able to solve all the town's\nproblems, they'll at least lend it to you."},
    QuestText{"QL_Gerudo_Ch_Helmet_Finish", "You solved the problems of everyone in town!\n\nRiju gave you the Gerudo's symbol of\nfriendship, and you got the Thunder Helm!"},
    QuestText{"QL_Gerudo_Ch_Helmet_Name", "The Thunder Helm"},
    QuestText{"QL_Gerudo_Ch_Poison_Desc", "Dalia has been working hard to start an orchard,\nbut garbage keeps appearing in her water\nsource, so her efforts are all for naught.\nWhat sort of vile polluter would toss his or her\ngarbage away with such indifference?"},
    QuestText{"QL_Gerudo_Ch_Poison_Finish", "Dalia planted the wildberries she received from\nCalyban and said that it's OK to pick them\nonce they grow in.\n\nWith the source of the water pollution cleared\nup, all that's left to do is wait for the wildberries\nto grow."},
    QuestText{"QL_Gerudo_Ch_Poison_Name", "The Mystery Polluter"},
    QuestText{"QL_Gerudo_Ch_Poison_Step1", "The water source got polluted with garbage, so\nthe water has become unusable. The cause\nturned out to be a woman throwing melon rinds\naway in the waterway upstream. She says if you\nbring her 10 wildberries from the snow-topped\npeaks of the Gerudo Highlands, she'll stop\neating so many melons..."},
    QuestText{"QL_Gerudo_Ch_Poison_Step2", "The water source was polluted with garbage, so\nthe water became unusable. The cause turned\nout to be a woman throwing melon rinds away\nin the waterway upstream. In exchange for 10\nwildberries, she agreed to stop eating melons.\nMaybe the water will clear up now.\n\nHurry back and report to Dalia."},
    QuestText{"QL_Gerudo_Ch_SandWarm_Desc", "Malena's husband has fallen ill. He needs the\nguts of a Molduga in order to get better. The\nMolduga is a ferocious monster that's sensitive\nto the slightest vibration, and it attacks anything\nthat comes near it. The woman is desperately\nlooking for help, but nobody seems capable..."},
    QuestText{"QL_Gerudo_Ch_SandWarm_Finish", "You handed over the Molduga guts to Malena\nto help fix her husband's illness.\n\nShe was overjoyed and left to get her husband\nhealthy again."},
    QuestText{"QL_Gerudo_Ch_SandWarm_Name", "Medicinal Molduga"},
    QuestText{"QL_Gerudo_Ch_SecretClub_Desc", "The clothes shop Fashion Passion has a\nsecret entrance where only members can get in.\nTo gain entrance, you need a secret password\nknown only to members. It seems that once you\ngive the wrong password, you won't be able to\ntry again for an entire day."},
    QuestText{"QL_Gerudo_Ch_SecretClub_Finish", "You discovered the secret password.\n\nThe password is \"GSC◆.\"\n\nNow you can go in whenever you want."},
    QuestText{"QL_Gerudo_Ch_SecretClub_Name", "The Secret Club's Secret"},
    QuestText{"QL_Gerudo_Ch_SnowBoots_Desc", "The eighth heroine actually had a sword!\n\nBozai may have just made it up, but it seems\nworth checking out, at least. The sword said to\nbe once held by the eighth heroine is most likely\nsomewhere in the Gerudo Highlands.\nShow a picture of the eighth heroine's sword to\nBozai to get the snow boots."},
    QuestText{"QL_Gerudo_Ch_SnowBoots_Finish", "You found the eighth heroine's sword at the\nsummit of the Gerudo Highlands.\n\nYou took a picture of the sword, so Bozai kept\nhis promise and gave you the snow boots."},
    QuestText{"QL_Gerudo_Ch_SnowBoots_Name", "The Forgotten Sword"},
    QuestText{"QL_Gerudo_Ch_SnowMT_Desc", "There's a legend about seven heroines in the\nGerudo region, but it turns out that an eighth\nheroine existed, and she is worshiped to this\nday by her faithful in the Gerudo Highlands. \nShow a picture of the eighth statue's torso to\nBozai to get the sand boots. You've heard that\nthere's someone well acquainted with the \nseven heroines' legend in Gerudo Town."},
    QuestText{"QL_Gerudo_Ch_SnowMT_Finish", "The eighth heroine is still worshiped by her\nfaithful in the Gerudo Highlands. You captured\nher in a picture and received the sand boots\nfrom Bozai as promised."},
    QuestText{"QL_Gerudo_Ch_SnowMT_Name", "The Eighth Heroine"},
    QuestText{"QL_Gerudo_HorseBuyer_Desc", "You ran into a traveler named Zyle on a road in\nthe Gerudo region—he's in trouble after losing\nhis horse on his journey.\n\nHe says he'll give you 300 rupees if you bring\nhim a horse...but it has to be appropriately\nsized for Zyle's body frame."},
    QuestText{"QL_Gerudo_HorseBuyer_Finish", "Zyle lost his horse during his travels and he\nseems to have approved of the one that you\ngave him to replace it.\n\nYou gave the horse to him for 300 rupees."},
    QuestText{"QL_Gerudo_HorseBuyer_Name", "Good-Sized Horse"},
    QuestText{"QL_Gerudo_tsukamidake_Desc", "Pirou at the Gerudo Canyon Stable claims that\nhe can't live without rushrooms, but because\nthey grow on cliffs, he's unable to pick them\nhimself. He's offered to trade a diamond for\n55 rushrooms."},
    QuestText{"QL_Gerudo_tsukamidake_Finish", "You traded 55 rushrooms to Pirou at the\nGerudo Canyon Stable for a diamond.\n\nBut it seems he could still use more.\n\nIf you bring them, he'll pay twice the market\nvalue for another 55 rushrooms."},
    QuestText{"QL_Gerudo_tsukamidake_Name", "Rushroom Rush!"},
    QuestText{"QL_Get_MasterSword_Desc", "Through the Lost Woods and deep within the\nKorok Forest sleeps the sword that seals the\ndarkness, a weapon said to be capable of\nstriking down the Calamity.\n\nThough you came to claim the sword, the \nDeku Tree told you the blade would test you...\nAlthough you wielded it 100 years ago, can\nyou pull the sword out in your current state?"},
    QuestText{"QL_Get_MasterSword_Finish", "You've acquired the legendary Master Sword,\nthat which seals the darkness. You feel that the\nsword itself delights to be in your possession...\n\nEven at this moment, Princess Zelda is within\nHyrule Castle, fighting to suppress the Calamity.\nShe endures, believing you will come for her...\n\nWill you be able to save her as you are now?"},
    QuestText{"QL_Get_MasterSword_Name", "The Hero's Sword"},
    QuestText{"QL_Giant_ZoraMini_Desc", "Torfeau of Zora's Domain tasked you with\nhunting a Hinox.\n\nThe giant in question is said to be at \nRalis Pond."},
    QuestText{"QL_Giant_ZoraMini_Finish", "You defeated the Hinox at Ralis Pond and\nreported it to Torfeau, who praised you."},
    QuestText{"QL_Giant_ZoraMini_Name", "The Giant of Ralis Pond"},
    QuestText{"QL_Giant_ZoraMini_Step1", "You successfully defeated the Hinox at \nRalis Pond.\n\nGo report back to Torfeau in Zora's Domain."},
    QuestText{"QL_GodTree_Desc", "You've accepted Zooki's Korok Trial.\nThe only hint:\n\n\"The hungry trees will show you the way.\nSpy their iron to win the day.\""},
    QuestText{"QL_GodTree_Finish", "\"The hungry trees will show you the way.\nSpy their iron to win the day.\"\n\nYou discovered an ancient shrine just beyond\nthe trees with iron orbs in their mouths."},
    QuestText{"QL_GodTree_Name", "Trial of Second Sight"},
    QuestText{"QL_GoronCamp_Desc", "You signed on for the hard-core training\nregimen of the three Goron Blood Brothers.\n\nThey call it the Gut Check Challenge!\n\nTalk to Bayge when you're ready."},
    QuestText{"QL_GoronCamp_Finish", "You showed the Goron brothers your grit knows\nno bounds, brother! You even passed the\nGut Check Challenge in one piece.\n\nImpressed with your performance, the Goron\nBlood Brothers let you through to the ancient\nshrine. They also invited you to challenge the\neven gutsier version of the course."},
    QuestText{"QL_GoronCamp_GameReady", "\"Stop checking your adventure log and start\nchecking your gut, brother. Go on! Hurry up\nand climb that cliff!\"\n-Bayge"},
    QuestText{"QL_GoronCamp_Name", "The Gut Check Challenge"},
    QuestText{"QL_GoronCamp_ResetGame", "Wh-what are you lookin' at all these words for,\nbrother?! These words shouldn't even be here!\nYou better report this to a supervisor\nimmediately!!!"},
    QuestText{"QL_GoronCityMini_BeatGolem_Beated", "You defeated the Igneo Talus at Darunia Lake!\nGo and tell Fugo!"},
    QuestText{"QL_GoronCityMini_BeatGolem_Desc", "Fugo needs to defeat the Igneo Talus at\nDarunia Lake to win his master Rohan's\nrespect.\n\nBut he's not sure about his ability to reach\nthe place to begin with, so he's looking for\nsomeone to fight the Igneo Talus in his stead."},
    QuestText{"QL_GoronCityMini_BeatGolem_Finish", "You defeated the Igneo Talus at Darunia Lake\nand reported back to Fugo. In return, he gave\nyou 100 rupees."},
    QuestText{"QL_GoronCityMini_BeatGolem_Name", "The Road to Respect"},
    QuestText{"QL_GoronMini_ImportGem_Desc", "Ramella, a precious-stone wholesaler, let you\nknow that she'll pay top rupee for gems.\n\nBring Ramella 10 pieces of amber to establish\na working relationship."},
    QuestText{"QL_GoronMini_ImportGem_Finish", "True to her word, Ramella paid well for your\n10 amber chunks.\n\nAs any merchant would, Ramella is looking to\nmaintain a steady stock of gems. She'll continue\nto pay well for whatever gems you bring her\nin the future."},
    QuestText{"QL_GoronMini_ImportGem_Name", "The Jewel Trade"},
    QuestText{"QL_GoronMini_WallCrackTBox_Desc", "Dugby, the young Goron soaking in the\nGoron Hot Springs, said: \n\n\"I bid a tweshure binteen gear an ba\nBridge of Eldin! Iz an abazing schtick!\nBeely bool! If boo bind it...iz boars!\"\n  \nIt sounds like gibberish, but maybe there's\nsomething to it after all?"},
    QuestText{"QL_GoronMini_WallCrackTBox_Finish", "The treasure that young Goron Dugby hid and\nalluded to turned out to be...a drillshaft!\n\nSince you found it, he's going to let you\nkeep it."},
    QuestText{"QL_GoronMini_WallCrackTBox_Get", "You found a drillshaft buried in a crag\nbetween the Bridge of Eldin and\nGoron Hot Springs.\n\nCould this be the treasure that Dugby\nmentioned? Try showing Dugby the\ndrillshaft you've acquired."},
    QuestText{"QL_GoronMini_WallCrackTBox_Name", "Death Mountain's Secret"},
    QuestText{"QL_GoronsRock_Desc", "Bladon's brother Gonguron should have been\nback by now...\n\nIt sounds like he went to Gorko Tunnel,\nsouthwest of Gorko Lake, to dig up the\nsecret of the hero."},
    QuestText{"QL_GoronsRock_Finish", "Gonguron ate the deliciously grilled rock roast,\ngiving him the energy he needed to break the\nwall covering an ancient shrine.\n\nBladon beamed with pride to see how strong\nGonguron had become."},
    QuestText{"QL_GoronsRock_Name", "A Brother's Roast"},
    QuestText{"QL_GoronsRock_Step005", "Now that Bladon knows what his brother\nGonguron was really up to, he wants you to\nfind and bring him a rock roast.\n\nRock roasts can be found around Gortram Cliff,\ndown the hill ahead of Gorko Tunnel."},
    QuestText{"QL_GoronsRock_Step010", "Now that Bladon knows what his brother\nGonguron was really up to, he wants you to\nfind and bring him a rock roast.\n\nBring a rock roast to Bladon and his brother,\nwho are waiting at Gorko Tunnel."},
    QuestText{"QL_GoronsRock_Step020", "Now that Bladon knows what his brother\nGonguron was really up to, he wants you to\nfind and bring him a rock roast.\n\nBring a rock roast to Bladon and his brother,\nwho are waiting at Gorko Tunnel."},
    QuestText{"QL_GoronsRock_Step030", "NOT USED * REPORT IF IT APPEARS"},
    QuestText{"QL_GoronsRock_Step040", "NOT USED * REPORT IF IT APPEARS"},
    QuestText{"QL_GotoZoraVillage_Desc", "Sidon, prince of the Zora, invited you to\ncome to Zora's Domain.\n\nHe warned you that owing to the heavy rains,\nthe rocks along the path are dangerously\nslippery."},
    QuestText{"QL_GotoZoraVillage_Finish", "You arrived at the throne room in\nZora's Domain.\n\nAccording to Sidon, Zora's Domain is in\ndanger, and they need the help of a strong\nHylian."},
    QuestText{"QL_GotoZoraVillage_Name", "Reach Zora's Domain"},
    QuestText{"QL_GotoZoraVillage_Step1", "You arrived at Zora's Domain. The next step\nis to visit King Dorephan in the throne room\non the top floor."},
    QuestText{"QL_HateeluMini_Treasure_Desc", "\"An ancient hero spoke these words:\n'One day I'll return to fight evil.\nMy cache is at 17 of 24,\nThis rock will point toward its retrieval.'\"\n\nThe ancient verse you heard from Kass\npoints to something, but what?"},
    QuestText{"QL_HateeluMini_Treasure_Finish", "\"An ancient hero spoke these words:\n'One day I'll return to fight evil.\nMy cache is at 17 of 24,\nThis rock will point toward its retrieval.'\"\n\nYou've solved the riddle of the ancient verse\nthat Kass recited and earned a gold rupee\nfor your trouble."},
    QuestText{"QL_HateeluMini_Treasure_Name", "The Hero's Cache"},
    QuestText{"QL_HatenoMini_BlueFire_Carry", "You lit the furnace at the\nAkkala Ancient Tech Lab with blue flame.\nThe ancient oven is now up and running\nagain.\n\nIt's time to go tell Robbie."},
    QuestText{"QL_HatenoMini_BlueFire_Desc", "Purah told you that any ancient materials\nyou find can be turned over to Robbie.\nYou can find him presiding over the\nAkkala Ancient Tech Lab."},
    QuestText{"QL_HatenoMini_BlueFire_Finish", "Though Robbie initially presumed that it was the\npower of love that set the ancient oven right\nagain, he soon realized the cause was actually\nyou lighting the furnace with blue flame.\n\nIf you give it some ancient materials\nand a generous supply of rupees, the\nancient oven will provide some\nancient soldier gear in exchange."},
    QuestText{"QL_HatenoMini_BlueFire_Meet", "You met Robbie, the director of the\nAkkala Ancient Tech Lab.\n\nHowever, Cherry—or rather, the ancient oven—\nisn't working at the moment, meaning it can't\ncreate ancient soldier gear for you.\n\nAll it (she?) needs to be up and running again\nis for you to light the furnace outside with the\nblue flame."},
    QuestText{"QL_HatenoMini_BlueFire_Name", "Robbie's Research"},
    QuestText{"QL_HatenoMini_CameraBoy_Desc", "The Sheikah Sensor + can detect anything\nalready registered in the Hyrule Compendium.\nTo demonstrate the possibilities, Symin gave\nyou some fieldwork.\n\nUse the Camera to register a sunshroom\nbehind the Hateno Ancient Tech Lab, and then\nreport back to Symin."},
    QuestText{"QL_HatenoMini_CameraBoy_Finish", "You gave Symin the three sunshrooms he\nrequested.\n\nSymin helped you see how valuable registering\nthings to your Hyrule Compendium can be.\nIf you have an item registered in your\ncompendium, it's easy to find with the\nSheikah Sensor +."},
    QuestText{"QL_HatenoMini_CameraBoy_Name", "Sunshroom Sensing"},
    QuestText{"QL_HatenoMini_CameraBoy_Shot", "Now that you've registered a sunshroom in the\nHyrule Compendium, the Sheikah Sensor + can\ndetect sunshrooms wherever you are.\n\nGo north of Hateno Village to Retsam Forest,\nand find three wild sunshrooms there.\nWhen you have all three, turn them over\nto Symin."},
    QuestText{"QL_HatenoMini_DevilSeal_Desc", "The horned statue in Hateno Village told you\nto increase either your Heart Containers or\nyour Stamina Vessel by one and come back."},
    QuestText{"QL_HatenoMini_DevilSeal_Finish", "You persuaded the horned statue to return your\ncontainer. Now you can exchange containers\nfor a small cost.\n\nThe horned statue will buy a Heart Container or\nStamina Vessel for 100 rupees and sell your\nchoice afterward for 120 rupees."},
    QuestText{"QL_HatenoMini_DevilSeal_GiveUtsuwa", "The horned statue in Hateno Village took one\nof your containers!\n\nThe only thing to do is talk to him and try to\nconvince him to give it back."},
    QuestText{"QL_HatenoMini_DevilSeal_Name", "The Statue's Bargain"},
    QuestText{"QL_HatenoMini_GoatThief_Desc", "A shepherd in Hateno Village named Koyin is\nworried that monsters will make off with her\nflock of sheep.\n\nAccording to her, the monsters in question\ncongregate at Hateno Beach. She won't\nbreathe easy until every last monster there\nis defeated."},
    QuestText{"QL_HatenoMini_GoatThief_Extermination", "You defeated every last monster lurking\non Hateno Beach! The village is safe for\nsheep at last.\n\nGo tell Koyin in Hateno Village that the\nmonsters will trouble her flock no more."},
    QuestText{"QL_HatenoMini_GoatThief_Finished", "You told Koyin that you cleared out the\nmonsters living on Hateno Beach. In return,\nshe gave you a handsome reward.\n\nYou feel like you're getting along quite well\nwith Koyin now! Maybe?"},
    QuestText{"QL_HatenoMini_GoatThief_Name", "The Sheep Rustlers"},
    QuestText{"QL_HatenoMini_LoveInsects_Answer", "Prima said her dream is to have a collection of\n100 restless crickets.\n\nYou should break the news to Manny."},
    QuestText{"QL_HatenoMini_LoveInsects_Desc", "A friend of Manny's wants more than anything\nto catch the eye of Prima, owner of the\nTon Pu Inn.\n\nAll you have to do is ask Prima what she\nloves most."},
    QuestText{"QL_HatenoMini_LoveInsects_Finish", "You delivered the 10 restless crickets to\nManny and received a reward.\n\nHe confessed that he was the one who wanted\nto catch Prima's eye. His plan now is to find the\nother 90 restless crickets on his own and\npresent them to Prima when he asks her out\non a date.\n\nIt seems you're off the hook..."},
    QuestText{"QL_HatenoMini_LoveInsects_Name", "A Gift for My Beloved"},
    QuestText{"QL_HatenoMini_LoveInsects_Report", "Upon learning that Prima's dream is to have\na collection of 100 restless crickets,\nManny enlisted your help as a bug catcher.\n\nStart by collecting 10 restless crickets and\nbringing them to Manny."},
    QuestText{"QL_HatenoMini_MyHome_Desc", "You can buy a house in Hateno Village!\n\nBolson, president of Bolson Construction,\noffered to slash his original asking price of\n50,000 rupees down to 3,000 rupees if you\nalso throw in 30 bundles of wood.\n\nWhat are you waiting for? Gather the wood\nand bring it to him!"},
    QuestText{"QL_HatenoMini_MyHome_Finish", "You ordered lots of furniture and exterior\nknickknacks, and your house is finally a home.\n\nBolson seems pretty relieved to have finished\nsuch a big job."},
    QuestText{"QL_HatenoMini_MyHome_Furniture", "Bolson offered to sell you furniture! Not only\nthat, he'll also remodel your home's exterior!\n\nRenovate your home with furniture and style\nto be the envy of your new neighbors!"},
    QuestText{"QL_HatenoMini_MyHome_Name", "Hylian Homeowner"},
    QuestText{"QL_HatenoMini_MyHome_Repurchase", "You bought a house in Hateno Village for\n3,000 rupees! Bolson generously furnished\na weapon rack inside your empty home as a\nhousewarming gift.\n\nThe place is still pretty bare, though. If you\ntalk to Bolson, he might be able to help you\nwith that."},
    QuestText{"QL_HatenoMini_MyHome_Wood", "You gave Bolson his wood and got him to\nslash his asking price for an old-fashioned\nhome from 50,000 rupees to 3,000 rupees.\n\nWhen you have the 3,000 rupees saved up,\ntalk to Bolson again to close the deal."},
    QuestText{"QL_HatenoMini_ThreeTree_Desc", "There is an old legend about the three cedar\ntrees on the snowy mountain visible from\nHateno Village.\n\n\"When the three summit trees become one,\nturn your back to them and head toward the\nsea. A trial encased in stone awaits you there.\""},
    QuestText{"QL_HatenoMini_ThreeTree_Finished", "\"When the three summit trees become one,\nturn your back to them and head toward the\nsea. A trial encased in stone awaits you there.\"\n\nYou solved the riddle of the three cedar trees\nand discovered the hero's trial."},
    QuestText{"QL_HatenoMini_ThreeTree_Name", "Secret of the Cedars"},
    QuestText{"QL_HatenoMini_WeaponMania_Desc", "A young man named Nebb in Hateno Village\nwants you to show him a particular weapon.\n\nIf you find a traveler's sword, bring it to him."},
    QuestText{"QL_HatenoMini_WeaponMania_Finish", "You showed Nebb, the young man in\nHateno Village, all the weapons he could\never want to see. He rewarded you with\na diamond.\n\nHe feels that his grandfather is unquestionably\nsmiling down on him from the next world now."},
    QuestText{"QL_HatenoMini_WeaponMania_Name", "The Weapon Connoisseur"},
    QuestText{"QL_HatenoMini_WeaponMania_Weapon01", "A young man named Nebb in Hateno Village\nwants you to show him a particular weapon.\n\nIf you find a fire rod, bring it to him."},
    QuestText{"QL_HatenoMini_WeaponMania_Weapon02", "A young man named Nebb in Hateno Village\nwants you to show him a particular weapon.\n\nIf you find a Moblin club, bring it to him."},
    QuestText{"QL_HatenoMini_WeaponMania_Weapon03", "A young man named Nebb in Hateno Village\nwants you to show him a particular weapon.\n\nIf you find a duplex bow, bring it to him."},
    QuestText{"QL_HatenoMini_WeaponMania_Weapon04", "A young man named Nebb in Hateno Village\nwants you to show him a particular weapon.\n\nIf you find a windcleaver, bring it to him."},
    QuestText{"QL_HatenoMini_WeaponMania_Weapon05", "A young man named Nebb in Hateno Village\nwants you to show him a particular weapon.\n\nIf you get an ancient battle axe+, take it to him."},
    QuestText{"QL_HatenoMini_WeaponMania_Weapon06", "A young man named Nebb in Hateno Village\nwants you to show him a particular weapon.\n\nIf you find a frostspear, bring it to him."},
    QuestText{"QL_HatenoMini_WeaponMania_Weapon07", "A young man named Nebb in Hateno Village\nwants you to show him a particular weapon.\n\nGet an ancient short sword and take it to him."},
    QuestText{"QL_HatenoMini_WhiteDragon_Desc", "Medda, a resident of Hateno Village, told you\nthat there is a Spring of Wisdom somewhere on\nMount Lanayru, which towers to the north\nof the village. The story goes that long ago,\na princess used that spring for a purification\nceremony. \n\nMoreover, there are rumors of a fantastic\ntreasure hidden in the spring."},
    QuestText{"QL_HatenoMini_WhiteDragon_Finish", "When you tossed Naydra's scale into the\nSpring of Wisdom, an ancient shrine appeared.\n\nFreed of the shackles of evil, Naydra flew\naway in peace."},
    QuestText{"QL_HatenoMini_WhiteDragon_Name", "The Spring of Wisdom"},
    QuestText{"QL_HatenoMini_WhiteDragon_Play", "You freed Naydra, the guardian dragon of the\nMount Lanayru spring, from the darkness that\nhad overcome it.\n\nWhen Naydra soared away into the heavens,\nit left behind Naydra's scale."},
    QuestText{"QL_HatenoMini_WhiteDragon_Step1", "You found no treasure but instead discovered\nNaydra, the Spring of Wisdom's guardian spirit,\nwho has been overtaken by darkness.\n\nBreak through the evil force possessing Naydra\nto set this great spirit free!"},
    QuestText{"QL_Hateno_SheikPad_PowerUp_Desc", "Purah has offered to help you out in exchange\nfor some ancient components.\n\nJust what are these ancient components?\nAnd who is Robbie? You'll have to ask Purah\nfor the answers."},
    QuestText{"QL_Hateno_SheikPad_PowerUp_Explain", "If you provide Purah with ancient components,\nshe can use them to strengthen your runes.\n\nThe Sheikah Sensor takes three \nancient screws, Remote Bombs\nrequire three ancient shafts, and\nStasis needs three ancient cores."},
    QuestText{"QL_Hateno_SheikPad_PowerUp_Finish", "Purah powered up your Sheikah Sensor,\nRemote Bombs, and Stasis!\n\nPurah claims that she's now pushed your\nrunes as far as they can go."},
    QuestText{"QL_Hateno_SheikPad_PowerUp_Name", "Slated for Upgrades"},
    QuestText{"QL_HigakkareMini_RedDragon_Desc", "You learned of a legend that says to offer a\nsacred relic to the Spring of Power, located\nto the west of East Akkala Stable.\n\nThe legend didn't say what this sacred relic\nmight be."},
    QuestText{"QL_HigakkareMini_RedDragon_Finish", "\"Offer Dinraal's scale received from the red spirit\nto the Spring of Power.\"\n\nWhen you carried out the statue's suggestion\nand dropped Dinraal's scale into the\nSpring of Power, an ancient shrine\nrevealed itself.\n\nSo the sacred relic was indeed Dinraal's scale..."},
    QuestText{"QL_HigakkareMini_RedDragon_Name", "The Spring of Power"},
    QuestText{"QL_HigakkareMini_RedDragon_Step1", "You found the Spring of Power and heard the\nGoddess's voice: \"Offer Dinraal's scale received\nfrom the red spirit to the Spring of Power.\"\n\nDoes this mean that the sacred relic is\nDinraal's scale? Who or what is Dinraal?"},
    QuestText{"QL_HigakkareMini_StrangeMan_Desc", "A mercenary named Hoz at East Akkala Stable\nasked you to investigate a suspicious character.\n\nWhoever it is apparently runs a business that he\ncalls Fang and Bone.\n\nIf you find someone fitting that description,\nget an image of him to show Hoz."},
    QuestText{"QL_HigakkareMini_StrangeMan_Finish", "You showed Hoz a picture of Kilton.\n\nHoz seems to have a better understanding of\nKilton's strange countenance."},
    QuestText{"QL_HigakkareMini_StrangeMan_Name", "A Shady Customer"},
    QuestText{"QL_HutagoHatago_Ch_001_Again", "Rensa, famous for taking second place at\nthe Hyrule Horse-Taming Competition, has\nthrown down the gauntlet!\n\nHis challenge: ride a wild horse to the stable\nwithin two minutes.\n\nWild horses are very wary of people, so this\nwill be no mean feat. This isn't your first time\naccepting his challenge."},
    QuestText{"QL_HutagoHatago_Ch_001_Desc", "Rensa, famous for taking second place at\nthe Hyrule Horse-Taming Competition, has\nthrown down the gauntlet!\n\nHis challenge: ride a wild horse to the stable\nwithin two minutes.\n\nWild horses are very wary of people, so this\nwill be no mean feat."},
    QuestText{"QL_HutagoHatago_Ch_001_Failed", "Rensa's challenge: ride a wild horse to the\nstable within two minutes.\n\nWild horses are very wary of people, so this\nwill be no mean feat. It would be nice if there\nwas someone around the stables who could\noffer you some advice on dealing with them..."},
    QuestText{"QL_HutagoHatago_Ch_001_Finish", "You rode a wild horse to the stable before time\nran out!\n\nRensa looks a little put out to have been\ndethroned in the Hyrule Horse-Taming\nCompetition."},
    QuestText{"QL_HutagoHatago_Ch_001_HorseGet", "Rensa, famous for taking second place at\nthe Hyrule Horse-Taming Competition, has\nthrown down the gauntlet!\n\nHis challenge: ride a wild horse to the stable\nwithin two minutes.\n\nYou caught a wild horse! Now you just need to\nget it back to Rensa in time."},
    QuestText{"QL_HutagoHatago_Ch_001_Name", "Wild Horses"},
    QuestText{"QL_HyruleDepthMini_WhiteHorse_Desc", "Toffa at the Outskirt Stable asked you to find\nthe royal family's white horse.\n\nSomeone else noticed a white horse on\nSafula Hill that had a beautiful, spotless white\ncoat and stood apart from the rest of the herd."},
    QuestText{"QL_HyruleDepthMini_WhiteHorse_Finish", "You showed the white horse to Toffa at\nOutskirt Stable. As thanks, he presented you\nwith a royal saddle and bridle.\n\nAccording to Toffa's grandfather, the sight\nof Princess Zelda at the reins of her white horse\nwas more beautiful than anything else he could\nimagine in the world."},
    QuestText{"QL_HyruleDepthMini_WhiteHorse_Name", "The Royal White Stallion"},
    QuestText{"QL_HyrulePlainMini_Balloon_Desc", "You promised Shamae, the kid from the\nWoodland Stable, that you'd show her a\nsky filled with balloons.\n\nThe first step is to find things that serve\nas balloons, and then use them to lift\nthe barrels to delight Shamae."},
    QuestText{"QL_HyrulePlainMini_Balloon_Finish", "With the ingenious use of Octo balloons, you\nkept your promise to Shamae.\n\nAs thanks, she gave you a star fragment."},
    QuestText{"QL_HyrulePlainMini_Balloon_Name", "Balloon Flight"},
    QuestText{"QL_Kakariko_Ch_004_Desc", "Kakariko Village is famous for its fireflies.\nWatching their faint glow in the night air is\na bit like gazing at the night sky.\n\nLasli, the clothes-shop barker, is a huge firefly\nfan. But she's under strict orders from her\ngrandmother not to walk outside late at night.\n\n\"If only the fireflies came to play here so I could\nstill see them...\" Can you make Lasli's wish\ncome true?"},
    QuestText{"QL_Kakariko_Ch_004_Finish", "Kakariko Village is famous for its fireflies.\nWatching their faint glow in the night air is\na bit like gazing at the night sky.\n\nLasli, the clothes-shop barker, is a huge firefly\nfan. Now that she can see her favorite sight\nfrom the comfort of home, she's happy again."},
    QuestText{"QL_Kakariko_Ch_004_Name", "By Firefly's Light"},
    QuestText{"QL_Kakariko_Ch_005_Desc", "Cottla runs carefree around the village.\nDuring the day, her sister is too busy with\nher cooking to have time to play. \n\nCottla is more bored than ever now..."},
    QuestText{"QL_Kakariko_Ch_005_Finish", "Cottla runs carefree around the village.\nDuring the day, her sister is too busy with\nher cooking to have time to play. \n\nCottla used to be bored, but now you've given\nher a fine playmate."},
    QuestText{"QL_Kakariko_Ch_005_Name", "Playtime with Cottla"},
    QuestText{"QL_Kakariko_Ch_006_Desc", "When Rola, owner of the general store, judged\nyou as a capable archer, she wasted no time\nrecruiting you for a seemingly simple job.\n\nAll she asked was that you \"light the torches\nby the Goddess Statue\" in the village, but her\nsuspiciously sweet smile made it clear that\nthis task would require unconventional methods."},
    QuestText{"QL_Kakariko_Ch_006_Finish", "In lighting the torches, you seem to have also\nignited Rola's passion. The day that she\ncan reunite with her husband may not be so\nfar off."},
    QuestText{"QL_Kakariko_Ch_006_Light", "\"Light the torches by the Goddess Statue.\"\n\nYou did as Rola asked and lit the torches.\nGo to her general store and tell her that\nwhat she requested is done."},
    QuestText{"QL_Kakariko_Ch_006_Name", "Arrows of Burning Heat"},
    QuestText{"QL_Kakariko_Ch_Cooking2_Desc", "Koko heated up the pot in an attempt to make\nhot buttered apples, but the lack of goat butter\nhad her stymied."},
    QuestText{"QL_Kakariko_Ch_Cooking2_Finish", "Koko heated up the pot in an attempt to make\nhot buttered apples, but the lack of goat butter\nhad her stymied.\nYou provided some goat butter, and the dish\nwas saved.\n\n　　\t/////Koko's Recipe Corner/////\nOne bushel of hot buttered apples:\n\nCoat apples evenly in goat butter and apply\nheat so it forms a nice, thick glaze."},
    QuestText{"QL_Kakariko_Ch_Cooking2_Name", "Cooking with Koko"},
    QuestText{"QL_Kakariko_Ch_Cooking3_Desc", "Koko donned her apron and prepared to\ndish up a tough meat-stuffed pumpkin for\nher exhausted father, Dorian.\n\nWithout any meat, though, this chef's in a bind.\nShe needs a skilled hunter to procure some\nmeat for her."},
    QuestText{"QL_Kakariko_Ch_Cooking3_Finish", "Koko donned her apron and prepared to\ndish up a tough meat-stuffed pumpkin  for\nher exhausted father Dorian. With the meat\nyou brought her, she served her father a\nrevitalizing tough meat-stuffed pumpkin.\n\n　　\t/////Koko's Recipe Corner/////\nOne tough meat-stuffed pumpkin :\n\nHollow out a fortified pumpkin and add any\nkind of meat. Bake until firm."},
    QuestText{"QL_Kakariko_Ch_Cooking3_Name", "Koko Cuisine"},
    QuestText{"QL_Kakariko_Ch_Cooking4_Desc", "Koko is trying to replicate the recipe for\nher mother's beloved honeyed apples,\nbut she's missing the essential\ncourser bee honey. The courser bees\nare found in dangerous territory outside\nof the village, beyond her reach..."},
    QuestText{"QL_Kakariko_Ch_Cooking4_Finish", "When you handed over the courser bee honey,\nthe missing ingredient Koko needed for her\nmother's special dessert, she prepared the dish.\nA single taste brought back a flood of memories\nfor her, as tears of joy streamed down her face.\n\n　　\t/////Koko's Recipe Corner/////\n1 serving of Mother's honeyed apples:\n\nDip an apple in courser bee honey. Heat until\nready to be sliced and serve warm."},
    QuestText{"QL_Kakariko_Ch_Cooking4_Name", "Koko's Specialty"},
    QuestText{"QL_Kakariko_Cha_001_Desc", "Today's special is hasty veggie cream soup!\nAt least, that's what Koko had in mind, but she\nforgot to stock up on swift carrots, the key\ningredient. \n\nHasty veggie cream soup is her little sister\nCottla's favorite meal, and Koko hates to see\nher cry. If only she had some swift carrots..."},
    QuestText{"QL_Kakariko_Cha_001_Finish", "Koko was panicking after forgetting to stock up\non swift carrots for the hasty veggie cream\nsoup. But now that she has the ingredients\nshe needs, there's a big smile on both Koko's\nand Cottla's faces.\n\n　　\t/////Koko's Recipe Corner/////\nOne serving of hasty veggie cream soup:\n\nAdd rock salt and fresh milk to a bowl of\nswift carrots. Heat and stir to taste."},
    QuestText{"QL_Kakariko_Cha_001_Name", "Koko's Kitchen"},
    QuestText{"QL_Kakariko_Cha_003_10kokko", "Cado's beloved Cuccos made it over the fence\nand escaped. It took a thorough search of the\nvillage, but you found them all.\n\nHurry and let Cado know so he can breathe\neasier."},
    QuestText{"QL_Kakariko_Cha_003_Desc", "Cado's beloved Cuccos made it over the fence\nand escaped.\n\nBefore the breakout, Cado had 10 Cuccos\nin total. Find all of them, and return them to\ntheir enclosure."},
    QuestText{"QL_Kakariko_Cha_003_Finish", "Cado's beloved Cuccos made it over the fence\nand escaped. It took a thorough search of the\nvillage, but you found them all.\n\nCado now has a better understanding of how\nmuch his Cuccos mean to him...as well as\nhis love for his wife."},
    QuestText{"QL_Kakariko_Cha_003_Name", "Flown the Coop"},
    QuestText{"QL_KnightDoll_Desc", "There are statues of the seven heroines east of \nGerudo Town. They may have something to do\nwith the location of a hidden shrine.\n\nFirst, solve the meaning behind the message:\n\"When the symbols of the seven find their place,\nthe blessed path will be revealed.\""},
    QuestText{"QL_KnightDoll_Finish", "\"When the symbols of the seven find their place,\nthe blessed path will be revealed.\"\n\nThe ancient shrine appeared after you matched\nthe symbols on the orbs with the symbols of the\nseven heroines."},
    QuestText{"QL_KnightDoll_Name", "The Seven Heroines"},
    QuestText{"QL_KorokMini_KorokShiren_Desc", "Chio told you about the Korok Trials.\n\nIn the southwest: Trial of Second Sight\nIn the northwest: The Lost Pilgrimage\nIn the east: The Test of Wood\n\nApparently the Korok Trials are somehow\nconnected to the ancient shrines."},
    QuestText{"QL_KorokMini_KorokShiren_Finish", "In the southwest: Trial of Second Sight\nIn the northwest: The Lost Pilgrimage\nIn the east: The Test of Wood\n\nYou completed these three trials, reported your\nsuccess to Chio, and received a reward."},
    QuestText{"QL_KorokMini_KorokShiren_Name", "The Korok Trials"},
    QuestText{"QL_KorokMini_KorokShiren_Step010", "In the southwest: Trial of Second Sight\nIn the northwest: The Lost Pilgrimage\nIn the east: The Test of Wood\n\nYou've completed these three trials.\nReport back to Chio!"},
    QuestText{"QL_KorokMini_RiddleShiren_Desc", "You have decided to take on the\nRiddles of Hyrule trial.\n\n\"Small, red, round, and sweet!\nBring me one of this simple treat!\"\n\nOnce you know the answer,\nbring the item to Walton!"},
    QuestText{"QL_KorokMini_RiddleShiren_Finish", "You answered all five of Walton's riddles,\ncompleting the Riddles of Hyrule trial!"},
    QuestText{"QL_KorokMini_RiddleShiren_Name", "Riddles of Hyrule"},
    QuestText{"QL_KorokMini_RiddleShiren_Step010", "You answered the first riddle correctly.\nThe second riddle is:\n\n\"Kakariko Village's specialty fruit!\nIts rock-hard flesh is quite resolute!\"\n\nOnce you know the answer,\nbring the item to Walton!"},
    QuestText{"QL_KorokMini_RiddleShiren_Step020", "You answered the second riddle correctly.\nThe third riddle is:\n\n\"This sultry shroom will warm your bones.\nIt makes its home in warmer zones.\"\n\nOnce you know the answer,\nbring the item to Walton!"},
    QuestText{"QL_KorokMini_RiddleShiren_Step030", "You answered the third riddle correctly.\nThe fourth riddle is:\n\n\"Its scales and tail will zap you, no doubt!\nThis shocking swimmer is called a...fish.\"\n\nOnce you know the answer,\nbring the item to Walton!"},
    QuestText{"QL_KorokMini_RiddleShiren_Step040", "You answered the fourth riddle correctly.\nThe fifth riddle is:\n\n\"If stepped on by this, you will go poof!\nIt starts with an H and ends with an oof!\"\n\nOnce you know the answer,\nbring the item to Walton!"},
    QuestText{"QL_KorokMini_RodShiren_Desc", "Kula asked you to show him a \"rod with the\npower of ice.\" Ice Wizzrobes are known to\ncarry them."},
    QuestText{"QL_KorokMini_RodShiren_Finish", "You showed Kula a rod that harnesses the\npower of ice!\n\nThe magical rod you now have can send blasts\nof ice at monsters to freeze them solid. It should\nbe very handy in battle."},
    QuestText{"QL_KorokMini_RodShiren_Name", "A Freezing Rod"},
    QuestText{"QL_KorokMini_UMAShiren_Desc", "Peeks really wants to see what a Blupee looks\nlike. Even a picture will do.\n\nApparently the Blupee is a mysterious \ncreature that glows brightly as it scampers\naround."},
    QuestText{"QL_KorokMini_UMAShiren_Finish", "You showed Peeks a picture of a Blupee.\n\n\nThe Blupee is a rare glowing creature that drops\nrupees when you shoot it with an arrow."},
    QuestText{"QL_KorokMini_UMAShiren_Name", "Legendary Rabbit Trial"},
    QuestText{"QL_MacuseIseki_Desc", "\"Only a hero bearing this ancient orb shall\nbe granted the right of trial on Rist Peninsula.\"\n\nYou recall these words engraved on the stone\ntablet and ponder their meaning again."},
    QuestText{"QL_MacuseIseki_Finish", "You discovered the hero's trial by carrying the\norb to the center of Rist Peninsula."},
    QuestText{"QL_MacuseIseki_Name", "Into the Vortex"},
    QuestText{"QL_MagneticFld_Desc", "In the Gerudo Desert Gateway, they say that\nthe swordswomen statues point the way to\ntreasure. However, getting there means braving\nthe sandstorms..."},
    QuestText{"QL_MagneticFld_Finish", "You followed the guidance of the swordswomen\nstatues to find the treasure amidst the\ndesert sandstorms. The prize turned out to\nbe an ancient shrine!"},
    QuestText{"QL_MagneticFld_Name", "The Silent Swordswomen"},
    QuestText{"QL_MarittaMini_BigWhales_Desc", "Akrah at the Serenne Stable asked you to\nget a visual record of the leviathan bones.\nThe record need not have the whole\nskeleton in it, so long as the skull is visible.\n\nLeviathan bones are apparently found\nin Eldin to the northeast, Hebra to the\nnorthwest, and Gerudo to the southwest."},
    QuestText{"QL_MarittaMini_BigWhales_Finish", "You took pictures of the leviathan bones in\nEldin, Hebra, and Gerudo. As thanks for\nadvancing the cause of paleontology, Akrah\ngave you 300 rupees."},
    QuestText{"QL_MarittaMini_BigWhales_Name", "Leviathan Bones"},
    QuestText{"QL_MinakkareMini_Dragonfly_Desc", "Jana wants to give her insect-loving little\nsister, Gleema, a birthday gift. But no matter\nhow many times Jana asks, Gleema won't tell\nher what kind of bug she wants.\n\nYou should talk to Gleema for the full story."},
    QuestText{"QL_MinakkareMini_Dragonfly_Dragonfly", "Despite Jana's severe aversion to dragonflies,\nshe's determined to give her little sister\nthe birthday gift she wants.\n\nBring Jana one warm darner, one cold darner,\nand one electric darner."},
    QuestText{"QL_MinakkareMini_Dragonfly_Finish", "You gave Gleema the warm darner,\ncold darner, and electric darner.\n\nJana gave you a reward for all your trouble."},
    QuestText{"QL_MinakkareMini_Dragonfly_Give", "You gave Gleema the warm darner,\ncold darner, and electric darner.\n\nIn her excitement, she forgot herself and\nrushed to show Jana. Can Jana's nerves\ntake the strain?"},
    QuestText{"QL_MinakkareMini_Dragonfly_LittleSister", "Gleema told you that she loves dragonflies\nabove all other insects, but Jana can't stand\nthe sight of them. You now understand why\nGleema can't tell her sister what she wants.\n\nYou'll have to tell Jana so the two of you can\ndecide what to do."},
    QuestText{"QL_MinakkareMini_Dragonfly_Name", "Little Sister's Big Request"},
    QuestText{"QL_MinakkareMini_Dragonfly_Through", "Unsurprisingly, Jana couldn't bring herself to\ntake the dragonflies from you.\n\nGive Gleema the warm darner, cold darner,\nand electric darner yourself."},
    QuestText{"QL_MinamihateeluMini_touzoku_Desc", "The treasure hunters Domidak and Prissen\naccidentally hinted at a riddle that points to the\nlocation of treasure hidden by Misko, the\nGreat Bandit.\n\n\"The little twin steps over the little river.\nMy cave rests above that river's source.\"\n\nIt could be that finding this treasure will grant\nyou riches beyond measure..."},
    QuestText{"QL_MinamihateeluMini_touzoku_Finish", "You got a riddle from the treasure hunters about\na treasure hidden by someone called Misko,\nthe Great Bandit:\n\n\"The little twin steps over the little river.\nMy cave rests above that river's source.\"\n\nYou managed to crack the riddle and locate\nthe treasure!"},
    QuestText{"QL_MinamihateeluMini_touzoku_Name", "Misko, the Great Bandit"},
    QuestText{"QL_MouthofDragon_Desc", "The ancient song that Kass sang at\nPagos Woods is hinting at something...\n\n\"Where the forest dragon splays its jaws,\nA shrine sleeps with noble cause.\"\n\nYour task is to decipher its riddle."},
    QuestText{"QL_MouthofDragon_Finish", "\"Offer Farosh's scale received from the\ngolden spirit to the Spring of Courage.\"\n\nJust as the Goddess instructed, you threw\nFarosh's scale into the Spring of Courage.\nA shrine appeared as a result!"},
    QuestText{"QL_MouthofDragon_Name", "The Serpent's Jaws"},
    QuestText{"QL_MouthofDragon_Step1", "Kass recited the lyrics to an ancient song when\nyou met him in Pagos Woods. You figured out\nthe hidden meaning of the song and\ndiscovered the Spring of Courage as a result.\nIt was at that moment that the voice of the\nGoddess spoke to you.\n\n\"Offer Farosh's scale received from the\ngolden spirit to the Spring of Courage.\"\n\nWhat's a Farosh's scale?"},
    QuestText{"QL_MtMotelMini_Landscape_Desc", "The landscape painting hanging on the wall\nof the Foothill Stable was painted by the\nstable's owner, Ozunda, who paints as a hobby.\n\nYou can make out details of the landscape\nsuch as a volcano and stable. Some of this\nseems familiar..."},
    QuestText{"QL_MtMotelMini_Landscape_Finished", "There is a landscape painting adorning the wall\nof the Foothill Stable.\n\nYou've discovered the shrine hidden in\nthe painting!"},
    QuestText{"QL_MtMotelMini_Landscape_Name", "A Landscape of a Stable"},
    QuestText{"QL_My_Hero_Desc", "Aliza waits for the hero's return around a stable\nat the edge of the plain. She says that she'll\nknow him by the sword of legend he carries."},
    QuestText{"QL_My_Hero_Finish", "Aliza was waiting for the hero's return around a\nstable at the plain's edge. When you showed\nher the Master Sword, she acknowledged you\nas the one she had been waiting for."},
    QuestText{"QL_My_Hero_Name", "My Hero"},
    QuestText{"QL_NakedIsland_Desc", "Upon arriving on Eventide Island, a voice spoke\nof a challenge and then took all of your\nweapons and armor away.\n\nNot feeling up for the challenge yet, you\ndecided to give up and got all of your\nequipment back.\n\nHowever, the trial is still out here, weighing\non your mind..."},
    QuestText{"QL_NakedIsland_Finish", "Once you offered precious orbs to each of the\nthree altars on the island, an ancient shrine\nappeared.\n\nAs it did, someone's voice spoke to you, and all\nof your equipment was returned."},
    QuestText{"QL_NakedIsland_Naked", "Upon arriving on Eventide Island, a voice spoke\nof a challenge and then took all of your\nweapons and armor away.\n\nIf you offer precious orbs to each of the three\naltars on the island, the voice has promised to\nreturn your things."},
    QuestText{"QL_NakedIsland_Name", "Stranded on Eventide"},
    QuestText{"QL_NakedIsland_OnceRetire", "Upon arriving on Eventide Island, a voice spoke\nof a challenge and then took all of your\nweapons and armor away.\n\nIf you offer precious orbs to each of the three\naltars on the island, the voice has promised to\nreturn your things."},
    QuestText{"QL_Oasis_Drug_Challenge_Desc", "Guy of the Kara Kara Bazaar needs a\ncooling elixir to beat the heat.\n\nThe medicine is made by combining a bug with \nchilling effects with monster parts. You'll find\nthe bug in question in the cooler parts of the\nGerudo Highlands."},
    QuestText{"QL_Oasis_Drug_Challenge_Finish", "You made a cooling elixir by combining a\nchilling insect with monster parts. Guy\nappreciated what you did for him.\n\nYour knowledge of the ingredients for a\ncooling elixir could come in handy later."},
    QuestText{"QL_Oasis_Drug_Challenge_Name", "An Ice Guy"},
    QuestText{"QL_OldKorok_Help_Desc", "The forest spirit Hestu has asked you to retrieve\nthe maracas that were stolen from him by a\ngroup of monsters camping nearby.\n\nHestu claims that he is unable to use his vast\npowers without the maracas."},
    QuestText{"QL_OldKorok_Help_Finish", "You returned Hestu's maracas after getting\nthem back from the monsters.\n\nWhen you returned the Korok seeds that you\nfound, he allowed you to carry more things."},
    QuestText{"QL_OldKorok_Help_Maracus", "You've safely returned the maracas, but now\nHestu is asking you to find the Korok seeds\nthat were once inside.\n\nThe more Korok seeds you find, the more\npower will return to Hestu's maracas, which\nhe can use to allow you to carry more things."},
    QuestText{"QL_OldKorok_Help_Name", "The Priceless Maracas"},
    QuestText{"QL_OneHundred_Desc", "Sesami and his friends ran afoul of monsters\nnear the roads at Koukot Plateau. Sesami ran\nfor his life, but his friends vanished into thin air.\n\nSesami was traveling with four friends. Find them\nquickly and put him at ease."},
    QuestText{"QL_OneHundred_Finish", "You saved all four of Sesami's friends, who had\nbeen pinned down by monsters and unable \nto move. And so, the curtain closes on the\ncase of the Gerudo Canyon disappearances."},
    QuestText{"QL_OneHundred_Name", "Missing in Action"},
    QuestText{"QL_OneHundred_Step1", "You rescued Sesami's friends, who were\nsurrounded by monsters and unable to move.\n\nHurry back to the Gerudo Canyon Stable and\ntell Sesami."},
    QuestText{"QL_PictureMemory_Desc", "Princess Zelda left behind an album with twelve\npictures in it. Traveling to the places shown in\nthese pictures may help you to regain your\nmemories of the princess.\n\nMemories remaining:"},
    QuestText{"QL_PictureMemory_Find11", "You've found all of the locations in\nthe pictures!\n\nGo and report the news to Impa in\nKakariko Village."},
    QuestText{"QL_PictureMemory_Finish", "You've visited all 13 of the locations shown in\nthe old pictures and recovered the associated\nmemories of your days with Princess Zelda.\n\nIn your memories, Princess Zelda always \nseemed burdened by her task...\n\nGo and save her as quickly as you can\nto finally ease that burden."},
    QuestText{"QL_PictureMemory_First1", "Princess Zelda left behind an album with twelve\npictures in it. Traveling to the places shown in\nthese pictures may help you to regain your\nmemories of the princess.\n\nMemories remaining: \n\nYou decided to report your progress so far to\nImpa in Kakariko Village."},
    QuestText{"QL_PictureMemory_GetShirt", "Princess Zelda left behind an album with twelve\npictures in it. Traveling to the places shown in\nthese pictures may help you to regain your\nmemories of the princess.\n\nMemories remaining:"},
    QuestText{"QL_PictureMemory_Last1", "The location of the final memory is hanging on\nthe wall of Impa's home.\n\nWhat memory of your past with Princess Zelda\nawaits you there?"},
    QuestText{"QL_PictureMemory_Name", "Captured Memories"},
    QuestText{"QL_Relief_Landing_Desc", "\"He breaks the rocks that serve to bind, \nAbove the tempestuous bay.\nOn wings of cloth and wood entwined,\nHe lands on the altar to open the way.\"\n\nSolve the mystery behind the song Kass taught\nyou to find the hero's trial."},
    QuestText{"QL_Relief_Landing_Finish", "\"He breaks the rocks that serve to bind, \nAbove the tempestuous bay.\nOn wings of cloth and wood entwined,\nHe lands on the altar to open the way.\"\n\nThe \"wings of cloth and wood entwined\" turned\nout to refer to the paraglider.\n\nAfter harnessing the wind and landing atop\nthe dais, a shrine appeared."},
    QuestText{"QL_Relief_Landing_Name", "Master of the Wind"},
    QuestText{"QL_Remains_Fancier_Desc", "Loone, lover of all things ancient, can't bear to\npart with her precious orb, Roscoe. Although,\nif you could somehow show her images of\nthree types of Guardians, she may change\nher tune.\n\nFigure out some way to safely show her what\nthe different Guardians look like. The three \ninclude small Guardians, flying Guardians, \nand Guardians that walk around."},
    QuestText{"QL_Remains_Fancier_Finish", "Loone, lover of all things ancient, relinquished\nher orb once you showed her pictures of the\nthree types of Guardians.\n\nWhen you placed the orb into the pedestal,\nan ancient shrine appeared!"},
    QuestText{"QL_Remains_Fancier_Name", "Guardian Slideshow"},
    QuestText{"QL_Remains_Fancier_Step1", "Loone, lover of all things ancient, relinquished\nher orb once you showed her pictures of the\nthree types of Guardians.\n\nYou've decided to go place it in the pedestal."},
    QuestText{"QL_RinelSearch_Desc", "Laflat asked that you show her a picture of a\nred-maned Lynel if you see one. The nearest\none she knows of is on Ploymus Mountain.\n\nUse whatever means you have at your\ndisposal to give her a look."},
    QuestText{"QL_RinelSearch_Finish", "You showed Laflat a picture of a red-maned\nLynel.\n\nShe gave you her Zora greaves as a reward."},
    QuestText{"QL_RinelSearch_Name", "Lynel Safari"},
    QuestText{"QL_RitoMini_Cook_Desc", "Juney, currently in Rito Village on her\nhoneymoon, is about to blow her stack\nif she can't find what she's looking for.\n\nDistracting her from her troubles with\na baked apple, her favorite snack,\nis one way to lighten the mood.\n\nBring Juney a baked apple and save\nher marriage!"},
    QuestText{"QL_RitoMini_Cook_Finish", "You gave Juney, currently honeymooning in\nRito Village, a baked apple. She was so\ngrateful that she paid you a few rupees for\nthe service.\n\nJuney told you that she'll never turn down\na baked apple. If you gather any more,\nbring them directly to her!"},
    QuestText{"QL_RitoMini_Cook_Name", "The Apple of My Eye"},
    QuestText{"QL_RitoMini_Flint_Desc", "Jogo is in Rito Village on his honeymoon,\nand he wants his new wife's favorite treat:\nbaked apples. The snag in the plan so far\nis that he has no fire to bake with.\n\nBring Jogo some flint so he can light a fire."},
    QuestText{"QL_RitoMini_Flint_Finish", "You gave Jogo, who is honeymooning in\nRito Village, some flint and received a\ntidy sum of rupees in return.\n\nJogo is planning to feed his wife as many\nbaked apples as he can cook. He'll gladly\ntake all the flint you're willing to deliver."},
    QuestText{"QL_RitoMini_Flint_Name", "The Spark of Romance"},
    QuestText{"QL_RitoMini_IceGolem_Beated", "You defeated the Frost Talus at\nColdsnap Hollow! Gesane at Rito Village\nwill surely be pleased once you report\nback to him."},
    QuestText{"QL_RitoMini_IceGolem_Desc", "Gesane, a Rito Village guardsman, said he \nsaw a frost Talus over at Coldsnap Hollow.\n\nIf you encounter a Frost Talus in your\ntravels there, be sure to destroy it."},
    QuestText{"QL_RitoMini_IceGolem_Finish", "You told the guardsman Gesane at Rito Village\nthat you destroyed the Frost Talus in\nColdsnap Hollow.\n\nGesane offered you rupees as thanks,\nwhich you gracefully accepted."},
    QuestText{"QL_RitoMini_IceGolem_Name", "Face the Frost Talus"},
    QuestText{"QL_RitoRabitMountain_Desc", "Molli in Rito Village told you a story about the\nlone cedar tree on the Hebra Mountains.\n\n\"Once upon a time, my grandpa stopped at a\nbig tree while he was climbing a big mountain\nand looked below him to the northwest. When\nsuddenly he saw a HUGE snow-white birdie with\nits wings spread wide! My grandpa took off\nflying after the snow-white birdie. And as he got\na little closer to the white birdie, Grandpa saw\nsomething SUPER important inside its belly!\""},
    QuestText{"QL_RitoRabitMountain_Finish", "When you looked out from the top of the lone\ncedar tree Molli told you about, you saw the\nshape of a large bird in the snowy cliff tops.\n\nAs you soared down to investigate, you\ncaught a glimpse of a hidden ancient shrine!"},
    QuestText{"QL_RitoRabitMountain_Name", "The Bird in the Mountains"},
    QuestText{"QL_RitoSongMystery_Desc", "\"The pride of the Rito, pillar in the sky,\nits heart lights up, when the sun is high.\"\n\nIt seems there is more to these lyrics than \nyou heard from Bedoli in the Rito Village.\n\nApparently Bedoli's sister Laissa knows\nthe last half of the song."},
    QuestText{"QL_RitoSongMystery_Finished", "\"The pride of the Rito, pillar in the sky,\nits heart lights up when the sun is high.\nThe heart shines upon a path not whole,\nbut a warming flame can stir its soul.\"\n\nThe lyrics in the ancient song from the\nRito Village were actually a clue to lead to\nthe entrance of a shrine!"},
    QuestText{"QL_RitoSongMystery_Name", "The Ancient Rito Song"},
    QuestText{"QL_RitoSongMystery_Sister", "You have heard the rest of the ancient Rito\nsong from Bedoli's sister, Laissa.\n\n\"The pride of the Rito, pillar in the sky,\nits heart lights up when the sun is high.\nThe heart shines upon a path not whole,\nbut a warming flame can stir its soul.\"\n\nWhat is the meaning hidden in these lyrics?"},
    QuestText{"QL_RitoUmayadoMini_HotRecipe_Desc", "Lester from the Rito Stable in the\nTabantha Frontier asked for Goron spice,\nan ingredient for curry rice.\n\nGet some Goron spice and deliver it\nto Lester at the Rito Stable."},
    QuestText{"QL_RitoUmayadoMini_HotRecipe_Finish", "Lester from the Rito Stable in the\nTabantha Frontier taught you to make\ncurry rice. The base ingredients are\nHylian rice and Goron spice.\nYou can add different ingredients to the\nbase recipe to make all sorts of curry rice.\n\nShould you ever be in need of Hylian rice,\nhe will trade you for some Goron spice."},
    QuestText{"QL_RitoUmayadoMini_HotRecipe_Name", "Curry for What Ails You"},
    QuestText{"QL_Rito_BrosRock_Desc", "Kheel, youngest of the five sisters inhabiting\nRito Village, is furious that her sisters haven't\nshown up for singing practice.\n\nGo and find her eldest sister, Notts, second-\neldest sister, Kotts, third-eldest sister, Genli,\nand fourth-eldest sister, Cree, somewhere\nin Rito Village, and tell them to meet Kheel."},
    QuestText{"QL_Rito_BrosRock_Finish", "You solved the mystery behind the Rito Village\nsong and Warbler's Nest, uncovering an\nancient shrine in the process!\n\nThe sisters, thrilled to practice their songs\nand find a secret, went back to Rito Village."},
    QuestText{"QL_Rito_BrosRock_Name", "Recital at Warbler's Nest"},
    QuestText{"QL_Rito_BrosRock_Rito_BrosRock_Step1", "You made salmon meunière for Genli,\nimproving her mood considerably.\n\nGo check on her sisters, who went to\nWarbler's Nest."},
    QuestText{"QL_Rito_BrosRock_Rito_BrosRock_Step2", "The five sisters sung an ancient song passed\ndown in the Rito Village that goes:\n\n\"When wind convinces the rocks to sing,\nopen the monk's door will swing.\"\n\nThere could be a secret hidden in the\nsong's lyrics."},
    QuestText{"QL_Rito_KeelSearch_Desc", "Amali's daughter Kheel has disappeared.\n\nShe may have gone to Warbler's Nest alone.\nFind Kheel and quell a worried mother's fears."},
    QuestText{"QL_Rito_KeelSearch_Finish", "Amali was relieved to hear that Kheel was only\npracticing her singing at Warbler's Nest.\n\nNow that you've assured her mother, Kheel\nhas a favor for you as well."},
    QuestText{"QL_Rito_KeelSearch_Name", "Find Kheel"},
    QuestText{"QL_Rito_KeelSearch_Step1", "Kheel was at Warbler's Nest practicing a song.\nLet Amali know she's safe."},
    QuestText{"QL_RiversideMini_CastleWeapon_Desc", "Though Hyrule Castle was destroyed 100 years\nago, somewhere inside it still sleeps rare\nequipment from those days. It is famed\namong collectors as the royal guard's series.\nParcy, a traveler at the stable, wants nothing\nmore than to see one of them.\n\nHowever, the castle is a dangerous place\nnowadays, and ordinary folk risk their lives\ngetting close..."},
    QuestText{"QL_RiversideMini_CastleWeapon_Finish", "Though Hyrule Castle was destroyed 100 years\nago, you ventured inside and found part of the\nroyal guard's series, famous among equipment\ncollectors.\n\nWhen you showed Parcy, the traveler at the\nstable, she seemed to be more curious about\nit than ever. Hopefully she won't do\nanything reckless..."},
    QuestText{"QL_RiversideMini_CastleWeapon_Name", "The Royal Guard's Gear"},
    QuestText{"QL_RiversideMini_RoyalRecipe_Desc", "Gotter, a beautiful man who works the stables,\nhas become completely infatuated with the\ncuisine once favored by the Hyrulean royal\nfamily. Eating it has been his lifelong dream\never since learning one of his ancestors was\na chef in Hyrule Castle.\n\nSome old cookbooks may still be lying around\nHyrule Castle."},
    QuestText{"QL_RiversideMini_RoyalRecipe_Finish", "You prepared a meal fit for a king and served it\nto the lovely stable worker Gotter. The dish\nwas just sublime, and he was most pleased.\n\nHe may even become more beautiful."},
    QuestText{"QL_RiversideMini_RoyalRecipe_Name", "A Royal Recipe"},
    QuestText{"QL_SandStorm_Desc", "At the Kara Kara Bazaar, they say that the\nsandstorm visible from camp hides a\ntreasure left by the ancients.\n\nKeep close watch for when the sandstorm\ndisappears, and then quickly hunt for the\ntreasure."},
    QuestText{"QL_SandStorm_Finish", "The treasure sleeping in the sandstorm visible\nfrom the Kara Kara Bazaar turned out to be an\nancient shrine.\n\nAll that is left now is to overcome the\nhero's trial within."},
    QuestText{"QL_SandStorm_Name", "The Eye of the Sandstorm"},
    QuestText{"QL_SanrokuMini_Lizard_Desc", "Kima at the Southern Mine has asked you to\ncatch ten of the fireproof lizards found on\nDeath Mountain near the Southern Mine.\n\nGo get 10 fireproof lizards, and take them\nto Kima."},
    QuestText{"QL_SanrokuMini_Lizard_Finish", "As thanks for the 10 fireproof lizards,\nKima gave you his flamebreaker armor!\n\nNot only that, but Kima will pay you 20 rupees\nfor every three fireproof lizards you bring him."},
    QuestText{"QL_SanrokuMini_Lizard_Name", "Fireproof Lizard Roundup"},
    QuestText{"QL_SearchStone_Desc", "Garini wants to know what the fragmented\nstone monument said when it was whole.\n\nHe's asked you to note down with whatever\ntools you have what each scattered fragment\nof the monument looks like."},
    QuestText{"QL_SearchStone_Finish", "You knelt on one platform as Garini took his\nplace on the other, causing an ancient shrine\nto appear!\n\nGarini seemed satisfied as he gazed upon the\nnew discovery."},
    QuestText{"QL_SearchStone_Name", "A Fragmented Monument"},
    QuestText{"QL_SearchStone_Step1", "You took pictures of the scattered fragments\nof the stone monument and showed them\nto Garini.\n\nOnce assembled, you discovered that the\nwriting on the monument read as follows:\n\n\"When the two find their place and kneel\nin reverence, the shrine will reveal itself.\""},
    QuestText{"QL_SecretofObject_Desc", "In a diary left long ago, there were a few\nlines on investigations concerning the\nmysterious pedestal. \n\n\"When the snowy mountain pedestal glows,\ncast a cold shadow onto its core.\"\n\nYou gather that there is a secret hidden in the \npedestal nestled in the snowcapped peaks."},
    QuestText{"QL_SecretofObject_Finish", "Casting a shadow on the mysteriously glowing\npedestal revealed none other than an\nancient shrine!\n\nNow venture inside and undergo the trial."},
    QuestText{"QL_SecretofObject_Name", "Secret of the Snowy Peaks"},
    QuestText{"QL_SeekerEye_Desc", "Geggle at the Tabantha Bridge Stable thinks\nthat a certain section of the cliff face in the\ndistance looks man-made.\n\nJust what could be hiding there?"},
    QuestText{"QL_SeekerEye_Finish", "When you tried going to the spot that Geggle\npointed out to you, you noticed a design\netched into the cliff.\n\nWhen you shot a shock arrow at the center of\nthe image, an ancient shrine appeared!"},
    QuestText{"QL_SeekerEye_Name", "Cliffside Etchings"},
    QuestText{"QL_SetugenUmayadoMini_Umahonephoto_Desc", "Juannelle in the Snowfield Stable wants to see\nwhat a Stalhorse looks like.\n\nWhat would be the best way to show her?\n\nShe's heard that the Stalhorse appears in the\neastern part of N. Tabantha Snowfield, in the\narea surrounding some strange ruins."},
    QuestText{"QL_SetugenUmayadoMini_Umahonephoto_Finish", "When you showed the picture of the Stalhorse\nto Juannelle, she carefully traced it so she'd\nhave her own copy.\n\nIt seems she plans on using the picture in an\narticle she's writing. With the picture for\ninspiration, she's excited to get to work!"},
    QuestText{"QL_SetugenUmayadoMini_Umahonephoto_Name", "Stalhorse: Pictured!"},
    QuestText{"QL_Shadow_Sign_Desc", "\"As light shines from the northwest skies,\nFrom the tower's shadow an arrow flies.\nPierce heaven's light to reveal the prize.\"\n\nSolving the riddle of the ancient song that\nKass sang for you at Gerudo Tower is likely\nto reveal a shrine."},
    QuestText{"QL_Shadow_Sign_Finish", "\"As light shines from the northwest skies,\nFrom the tower's shadow an arrow flies.\nPierce heaven's light to reveal the prize.\"\n\nWhen the light was in the northwest, you saw\nGerudo Tower cast a shadow upon a pedestal.\nAfter firing an arrow toward the light from the top\nof that pedestal, a shrine appeared!"},
    QuestText{"QL_Shadow_Sign_Name", "Sign of the Shadow"},
    QuestText{"QL_ShieldofKolog_Desc", "You've decided to undergo the trial Damia\ngave you in Korok Forest.\n\nTalk to Damia when you're ready to begin."},
    QuestText{"QL_ShieldofKolog_Finish", "You arrived at your destination with\nthe forest dweller's sword,\nforest dweller's bow, and\nforest dweller's shield equipped.\nThere, you found an ancient shrine."},
    QuestText{"QL_ShieldofKolog_Name", "The Test of Wood"},
    QuestText{"QL_ShieldofKolog_Step010", "With the forest dweller's sword,\nforest dweller's bow, and\nforest dweller's shield equipped,\nhead for your destination."},
    QuestText{"QL_Solitary_Maze_Desc", "When you approached the curious ruins on\nthe island in the Akkala Sea, you heard a\nvoice speak to you.\n\nIt told you that you will be granted a blessing\nif you travel through the island maze."},
    QuestText{"QL_Solitary_Maze_Finish", "The labyrinth on the solitary island was\ndifficult, but you prevailed.\n\nWhen you reached the end of the maze,\nyou found an ancient shrine waiting for you."},
    QuestText{"QL_Solitary_Maze_Name", "Trial of the Labyrinth"},
    QuestText{"QL_StatueofZora_Desc", "Laruta taught you the Zora song of the\nChampion ceremony.\n\n\"A gift from the sky: a scale of light\nSplits the feet of a Veiled Falls sight.\nYour trial awaits... It's glowing bright.\"\n\nTrello seems to know more about the\nceremony."},
    QuestText{"QL_StatueofZora_Finish", "You thrust the spear that Trello dropped into\nthe pedestal hidden in Veiled Falls, causing\nan ancient shrine to appear."},
    QuestText{"QL_StatueofZora_Name", "The Ceremonial Song"},
    QuestText{"QL_StatueofZora_Step1", "Laruta taught you the Zora song of the\nChampion ceremony.\n\n\"A gift from the sky: a scale of light\nSplits the feet of a Veiled Falls sight.\nYour trial awaits... It's glowing bright.\"\n\nTrello accidentally dropped the Ceremonial\nTrident used in the Champion ceremony off of\nthe bridge. If you find the spear and re-create\nthe actions from the song, a new trial may open."},
    QuestText{"QL_StolenBook_Desc", "The heirloom at Impa's manor has been stolen.\nDorian and Cado, the manor's gatekeepers,\nsay that it should have been impossible to\nsteal with Paya keeping close watch over it all\nday long.\n\nYour best lead so far is the rumors circulating\nabout suspicious figures seen lately at night."},
    QuestText{"QL_StolenBook_Finish", "It turned out that the heirloom thieves who\nstruck Impa's manor belonged to the Yiga Clan.\nThe incident was revenge for Dorian attempting\nto leave the guild of assassins.\n\nAfter you solved the problem, you returned the\nheirloom and discovered a new ancient shrine."},
    QuestText{"QL_StolenBook_Name", "The Stolen Heirloom"},
    QuestText{"QL_SunazarashiRace_Desc", "You've decided to challenge the sand-seal\nracing world champion, Tali!\n\nIt seems that, if you can beat the race record,\nthe way to a shrine will open for you.\n\nThe champion's current record stands at 1\nminute and 30 seconds.\n\nThis won't be easy."},
    QuestText{"QL_SunazarashiRace_Finish", "When you placed the jewel on the pedestal,\na shrine appeared!\n\nYou're now able to enter a sand-seal race any\ntime you want, too. Aim to set a new record!"},
    QuestText{"QL_SunazarashiRace_IfGetOff", "You beat Tali's sand-seal-racing record!\n\nAs proof of your victory, you've received a jewel!\nWhat happens when you place this jewel on\nthe pedestal?"},
    QuestText{"QL_SunazarashiRace_Name", "The Undefeated Champ"},
    QuestText{"QL_SunazarashiRace_Step1", "You've decided to challenge the sand-seal\nracing world champion, Tali, but beating her\ncurrent record of 1 minute and 30 seconds \nwon't be easy.\n\nHowever, it's the only way to open the shrine,\nso you should keep trying!"},
    QuestText{"QL_SunazarashiRace_Step2", "You beat Tali's sand-seal-racing record!\n\nAs proof of your victory, you've received a jewel!\nWhat happens when you place this jewel on\nthe pedestal?"},
    QuestText{"QL_SunazarashiRace_Step3", "You beat Tali's sand-seal-racing record!\n\nAs proof of your victory, you've received a jewel!\nWhat happens when you place this jewel on\nthe pedestal?"},
    QuestText{"QL_TabantaBridgeMini_Sundial_Desc", "At the Tabantha Bridge Stable, Toren gave you\n500 rupees and asked you to make an offering\nto the Great Fairy.\n\nClimb the tower beyond Tabantha Great Bridge\nin the afternoon and follow its shadow to locate\nthe Great Fairy Fountain."},
    QuestText{"QL_TabantaBridgeMini_Sundial_Finish", "You told Toren that you made an offering to the\nGreat Fairy.\n\nWill Toren's lifelong dream of meeting the\nGreat Fairy come true for him at last?"},
    QuestText{"QL_TabantaBridgeMini_Sundial_Name", "A Gift for the Great Fairy"},
    QuestText{"QL_TabantaBridgeMini_Sundial_Play", "You made an offering to the Great Fairy,\nfulfilling your promise to Toren.\n\nReport back to the Tabantha Bridge Stable \nwhere Toren is waiting."},
    QuestText{"QL_Threebros_giant_Desc", "The ancient spheres guarded by the\nMount Taran sentinels shall lead you to\nthe hero's trial.\n\nCould the giants who inhabit the area hold\nthe key to unlocking the trial?"},
    QuestText{"QL_Threebros_giant_Finish", "The three Hinox brothers living on Mount Taran\neach had an orb hanging from their neck.\n\nOffering these orbs to the matching pedestals\ncaused an ancient shrine to appear."},
    QuestText{"QL_Threebros_giant_Name", "The Three Giant Brothers"},
    QuestText{"QL_Thunder_Sword_Desc", "\"When a lost hero calls down lightning\nfrom the sky / The monk responds from\na giant mound on high.\"\n\nSolve the riddle of the song you learned from\nKass and seek out the hero's trial."},
    QuestText{"QL_Thunder_Sword_Finish", "\"When a lost hero calls down lightning\nfrom the sky / The monk responds from\na giant mound on high.\"\n\nYou found an ancient shrine inside the rock \nthat you shattered with lightning!"},
    QuestText{"QL_Thunder_Sword_Name", "A Song of Storms"},
    QuestText{"QL_Thunder_Sword_Step010", "\"When a lost hero calls down lightning\nfrom the sky / The monk responds from\na giant mound on high.\"\n\nBy attracting a lightning strike, you shattered\nthe large rock and revealed an ancient shrine\nconcealed within."},
    QuestText{"QL_TreasureHunt01_Desc", "Rumor has it there's an item called the\nKorok Mask that has the power to alert its\nwearer when a Korok is hiding nearby.\n\nApparently the Woodland Stable has a copy of\nSuper Rumor Mill EX, which details some rumors\nabout this rare mask."},
    QuestText{"QL_TreasureHunt01_Finish", "You found the Korok Mask in the spooky tree's\nhollow within the Lost Woods!\n\nThe Korok Mask will inform you when a Korok\nis hiding nearby."},
    QuestText{"QL_TreasureHunt01_Name", "EX Strange Mask Rumors"},
    QuestText{"QL_TreasureHunt01_Step01", "You read Super Rumor Mill EX: Volume 1!\nAccording to this special issue, there are\nrumors of an item called the Korok Mask\nthat has been inhabited by a friendly spirit.\n\nThe treasure chest containing the Korok Mask\nis hidden in the hollow of a terrifying tree in a\nforest that causes those who enter to lose their\nway. Find that forest and locate the treasure\nchest! It also seems there's a convenient way\nto search for it..."},
    QuestText{"QL_TreasureHunt02_Desc", "Rumor has it there's a tool that allows you to\ninstantly travel to wherever you've placed it.\n\nApparently South Akkala Stable has a copy \nof Super Rumor Mill EX, which details some\nrumors about this rare item..."},
    QuestText{"QL_TreasureHunt02_Finish", "You managed to reach Lomei Labyrinth Island\nand found the Travel Medallion in a secret\nunderground room!\n\nJust as the rumors said, the Travel Medallion\nlets you travel instantly to whatever location\nyou've placed it at.\n\nIt seems believing those rumors paid off!"},
    QuestText{"QL_TreasureHunt02_Name", "EX Teleportation Rumors!"},
    QuestText{"QL_TreasureHunt02_Step01", "You read Super Rumor Mill EX: Volume 2!\nAccording to this special issue, there are\nrumors of an item that lets you instantly\ntravel to a location of your choosing.\n\nThe treasure chest containing this item is\nsupposedly located in northeast Akkala,\nhidden beneath a labyrinth.\n\nIf you believe the rumors, try to find the\nlabyrinth and locate the treasure chest!"},
    QuestText{"QL_TreasureHunt03_Desc", "Rumor has it there's a bridle that enhances a\nhorse's skill and a saddle that can summon\nyour horse right to you. Does this supposed\nancient horse gear really exist?\n\nApparently Highland Stable has a copy of\nSuper Rumor Mill EX, which details some\nrumors about this rare horse gear."},
    QuestText{"QL_TreasureHunt03_Finish", "You found the ancient horse gear at\nSatori Mountain and Malanya Spring!\n\nEquip your horse with the Ancient Bridle for a\nlonger-lasting gallop. Equip the Ancient Saddle\nand your horse will come running whenever\nyou call, no matter how far you are.\nBelieving those rumors really paid off!"},
    QuestText{"QL_TreasureHunt03_Name", "EX Ancient Horse Rumors"},
    QuestText{"QL_TreasureHunt03_Step01", "You read Super Rumor Mill EX: Volume 3!\nAccording to this special issue, there's a bridle\nthat enhances your horse's skill and a saddle\nthat summons your horse to your side.\nOne is supposedly under a cherry blossom tree\nat a mountain where creatures gather, and the\nother is at a spring where a horse spirit resides.\n\nIf you believe the rumors, try to find\nthe hidden treasure!\nTreasure chests remaining:"},
    QuestText{"QL_TreasureHunt04_Desc", "Rumor has it a Royal Guard uniform can still be\nfound at Hyrule Castle.\n\nApparently Riverside Stable has a copy of\nSuper Rumor Mill EX, which details some\nrumors about this rare outfit."},
    QuestText{"QL_TreasureHunt04_Finish", "You found the royal guard uniform from treasure\nchests in the hidden room near the dining hall,\nthe storage space in the guards' chamber,\nand on the second floor of the castle.\n\nBelieving those rumors really paid off!"},
    QuestText{"QL_TreasureHunt04_Name", "EX Royal Guard Rumors"},
    QuestText{"QL_TreasureHunt04_Step01", "You read Super Rumor Mill EX: Volume 4!\nAccording to this special issue, Hyrule Castle\nstill houses a uniform once belonging to the\nroyal guards who protected the royal family.\nIt can supposedly be found in treasure chests\nhidden near the dining hall, in the guards'\nchamber, and on the second floor.\n\nIf you believe the rumors, try to find the\nhidden treasure!\nTreasure chests remaining:"},
    QuestText{"QL_TreasureHunt_touzoku01_Desc", "The royal family of Hyrule collected historically\nsignificant outfits, but they were stolen by a\nbandit named Misko. One of the items stolen\nwas an ancient mask.\n\nThere's a journal that places the location of this\ntreasure somewhere in the Outpost Ruins..."},
    QuestText{"QL_TreasureHunt_touzoku01_Finish", "\"The ancient mask lies at the ruins where\nsoldiers gathered. From there, the waters\nof Lake Kolomo are visible.\"\n\nYou found the treasure that was hidden\nat Kolomo Garrison Ruins and obtained\nMajora's Mask!"},
    QuestText{"QL_TreasureHunt_touzoku01_Name", "EX Treasure: Ancient Mask"},
    QuestText{"QL_TreasureHunt_touzoku01_Step01", "\"The ancient mask lies at the ruins where\nsoldiers gathered. From there, the waters\nof Lake Kolomo are visible.\"\n\nMisko's EX Journal gives the location of\nthe ancient mask...but where could it be\ntalking about?"},
    QuestText{"QL_TreasureHunt_touzoku02_Desc", "The royal family of Hyrule collected historically\nsignificant outfits, but they were stolen by a\nbandit named Misko. One of the items stolen\nwas a helmet of twilight...\n\nThere's a journal that places the location of this\ntreasure somewhere in the Outpost Ruins..."},
    QuestText{"QL_TreasureHunt_touzoku02_Finish", "\"The princess of twilight, whose stories\nare handed down alongside those of\nthe Hero of Twilight...\nHer helmet can be found at the\ntemple ruins soaked in the waters\nof Regencia River.\"\n\nYou found the treasure that was hidden\nat Sage Temple Ruins and obtained\nMidna's Helmet!"},
    QuestText{"QL_TreasureHunt_touzoku02_Name", "EX Treasure: Twilight Relic"},
    QuestText{"QL_TreasureHunt_touzoku02_Step01", "\"The princess of twilight, whose stories\nare handed down alongside those of\nthe Hero of Twilight...\nHer helmet can be found at the\ntemple ruins soaked in the waters\nof Regencia River.\"\n\nMisko's EX Journal gives the location of the\nhelmet of twilight...but where could these\nwater-soaked ruins be?"},
    QuestText{"QL_TreasureHunt_touzoku03_Desc", "The royal family of Hyrule collected historically\nsignificant outfits, but they were stolen by a\nbandit named Misko. Among the items stolen\nwere a fairy's green garments.\n\nThere's a journal that places the locations of\nthe treasure somewhere in the Outpost Ruins..."},
    QuestText{"QL_TreasureHunt_touzoku03_Finish", "\"The green garments of the man who wished to\nbe a fairy are hidden in the ruins of Hyrule Field.\nFind these pieces at the ruins where trade\nflourished...at the ruins where sinners were\nimprisoned...and at the village ruins next to\nfarmland where many people once gathered.\"\n\nYou found the treasure that was hidden\nat Exchange Ruins, Castle Town Prison,\nand Mabe Village Ruins. You obtained\nTingle's Outfit!"},
    QuestText{"QL_TreasureHunt_touzoku03_Name", "EX Treasure: Fairy Clothes"},
    QuestText{"QL_TreasureHunt_touzoku03_Step01", "\"The green garments of the man who wished to\nbe a fairy are hidden in the ruins of Hyrule Field.\nFind these pieces at the ruins where trade\nflourished...at the ruins where sinners were\nimprisoned...and at the village ruins next to\nfarmland where many people once gathered.\"\n\nMisko's EX Journal gives the location\nof the fairy's green garments.\nGarments still hidden:"},
    QuestText{"QL_TreasureHunt_touzoku04_Desc", "The royal family of Hyrule collected historically\nsignificant outfits, but they were stolen by a\nbandit named Misko. Among the items stolen\nwas some phantasmal armor.\n\nThere's a journal that places the locations of\nthe treasure somewhere in the Outpost Ruins..."},
    QuestText{"QL_TreasureHunt_touzoku04_Finish", "\"Armor worn by fierce phantoms, feared even by\nheroes, is hidden in the ruins of Hyrule Field.\nFind these pieces at a battleground where brave\nsouls tested their skill...at ceremonial grounds\nwhere royal guards are honored...and at the\nruins where the soldiers of Hyrule gathered.\"\n\nYou found the treasure that was hidden at\nColiseum Ruins, Sacred Ground Ruins,\nand Hyrule Garrison Ruins. You obtained\nthe Phantom Equipment!"},
    QuestText{"QL_TreasureHunt_touzoku04_Name", "EX Treasure: Phantasma"},
    QuestText{"QL_TreasureHunt_touzoku04_Step01", "\"Armor worn by fierce phantoms, feared even by\nheroes, is hidden in the ruins of Hyrule Field.\nFind these pieces at a battleground where brave\nsouls tested their skill...at ceremonial grounds\nwhere royal guards are honored...and at the\nruins where the soldiers of Hyrule gathers.\"\n\nMisko's EX Journal gives the location\nof the phantasmal armor.\nEquipment still hidden:"},
    QuestText{"QL_TreasureHunt_touzoku05_Desc", "The royal family of Hyrule collected historically\nsignificant outfits, but they were stolen by a\nbandit named Misko. One of the items stolen\nwas a traveling merchant's hood.\n\nSomewhere in the Deya Village Ruins\nis a journal that places the location\nof this treasure..."},
    QuestText{"QL_TreasureHunt_touzoku05_Finish", "\"The traveling merchant's hood is in the\nright hand of the dragon that consumes\nthe Spring of Courage at Dracozu Lake.\"\n\nYou located the treasure chest in the right hand\nof the dragon ruins at Dracozu Lake and got\nRavio's Hood!"},
    QuestText{"QL_TreasureHunt_touzoku05_Name", "EX Treasure: Merchant Hood"},
    QuestText{"QL_TreasureHunt_touzoku05_Step01", "\"The traveling merchant's hood is in the\nright hand of the dragon that consumes\nthe Spring of Courage at Dracozu Lake.\"\n\nMisko's EX Journal 2 notes where the traveling\nmerchant's hood is hidden...but where could\nthis mysterious dragon be?"},
    QuestText{"QL_TreasureHunt_touzoku06_Desc", "The royal family of Hyrule collected historically\nsignificant outfits, but they were stolen by a\nbandit named Misko. One of the items stolen\nwas the blue garb of the Hero of Winds.\n\nSomewhere in the Deya Village Ruins\nis a journal that places the location\nof this treasure..."},
    QuestText{"QL_TreasureHunt_touzoku06_Finish", "\"The blue garb of the hero who controlled\nthe wind and traveled the ocean is where\nthe Menoat River was born.\"\n\nYou found the treasure that was hidden at Cora\nLake and obtained the Island Lobster Shirt!"},
    QuestText{"QL_TreasureHunt_touzoku06_Name", "EX Treasure: Garb of Winds"},
    QuestText{"QL_TreasureHunt_touzoku06_Step01", "\"The blue garb of the hero who controlled\nthe wind and traveled the ocean is where\nthe Menoat River was born.\"\n\nMisko's EX Journal 2 describes where the blue\ngarb of the Hero of Winds is hidden...but where\nwas the Menoat River born?"},
    QuestText{"QL_TreasureHunt_touzoku07_Desc", "The royal family of Hyrule collected historically\nsignificant outfits, but they were stolen by a\nbandit named Misko. One of the items stolen\nwas the helmet of the Usurper King.\n\nSomewhere in the Deya Village Ruins\nis a journal that places the location\nof this treasure..."},
    QuestText{"QL_TreasureHunt_touzoku07_Finish", "\"The helm of the self-proclaimed King of\nShadows is in the swamp of the valley\nof dead trees, south of Dueling Peaks.\"\n\nYou found the treasure that was hidden at\nTobio's Hollow and obtained Zant's Helmet!"},
    QuestText{"QL_TreasureHunt_touzoku07_Name", "EX Treasure: Usurper King"},
    QuestText{"QL_TreasureHunt_touzoku07_Step01", "\"The helm of the self-proclaimed King of\nShadows is in the swamp of the valley\nof dead trees, south of Dueling Peaks.\"\n\nMisko's EX Journal 2 notes where the Usurper\nKing's Helmet is hidden...but where could it\nbe talking about?"},
    QuestText{"QL_TreasureHunt_touzoku08_Desc", "The royal family of Hyrule collected historically\nsignificant outfits, but they were stolen by a\nbandit named Misko. One of the items stolen\nwas armor belonging to a dark entity.\n\nSomewhere in the Deya Village Ruins\nis a journal that places the location\nof this treasure..."},
    QuestText{"QL_TreasureHunt_touzoku08_Finish", "\"The evil spirit's armor set is hidden within\nFaron's sea of trees. Find these pieces at\nthe highest of three waterfalls north of\nLake Floria...at the bridge between small\nwaterfalls over Floria River...and at the\nbroken stone bird of Ebara Forest.\"\n\nYou found the treasure hidden at Corta Lake,\nSarjon Bridge, and Ebara Forest.\nYou obtained the Phantom Ganon set!"},
    QuestText{"QL_TreasureHunt_touzoku08_Name", "EX Treasure: Dark Armor"},
    QuestText{"QL_TreasureHunt_touzoku08_Step01", "\"The evil spirit's armor set is hidden within\nFaron's sea of trees. Find these pieces at\nthe highest of three waterfalls north of\nLake Floria...at the bridge between small\nwaterfalls over Floria River...and at the\nbroken stone bird of Ebara Forest.\"\n\nMisko's EX Journal 2 gives the locations\nof the evil spirit's armor.\n\nArmor still hidden:"},
    QuestText{"QL_TwoWheels_Desc", "Kass taught you an ancient song.\n\n\"When a single arrow threads two rings,\nthe shrine will rise like birds on wings.\"\n\nDoes the song reference something specific\nto the area?"},
    QuestText{"QL_TwoWheels_Finish", "\"When a single arrow threads two rings,\nthe shrine will rise like birds on wings.\"\n\nAn ancient shrine appeared when you loosed\na single arrow through two ring-shaped rocks."},
    QuestText{"QL_TwoWheels_Name", "The Two Rings"},
    QuestText{"QL_UMiiMini_GiveCake_Desc", "You overheard a fight between Hagie and Ruli,\nhusband and wife. Their daughter Hunnie is sick\nand won't get better if she doesn't eat. But the\nthing is, the only food she has an appetite for is\ncake, and finding a particular cake to please her\nhas proven nearly impossible. Ruli is at her wit's\nend, ready to even trade her soul to a monster\nif it means finding a cake her daughter will eat.\n\nWhere are you going to find a suitable cake?"},
    QuestText{"QL_UMiiMini_GiveCake_Finish", "You were generously rewarded for giving Ruli\na monster cake.\n\nHer daughter Hunnie seems to have made\na full recovery, well enough even to play\noutside again."},
    QuestText{"QL_UMiiMini_GiveCake_Give", "You gave Ruli a monster cake!\n\nHer sick daughter, Hunnie, who has not\nhad an appetite for anything but cake\nlately, was able to eat it.\n\nCheck in with Ruli to find out how Hunnie\nis doing."},
    QuestText{"QL_UMiiMini_GiveCake_Name", "A Parent's Love"},
    QuestText{"QL_UMiiMini_MakeVillage_Desc", "Hudson, Bolson Construction's veteran\ncarpenter, has departed for the Akkala\nregion to expand the business.\n\nAkkala is far to the north of Hateno Village.\nIf you happen to be passing by, stop in and\npay Hudson a visit."},
    QuestText{"QL_UMiiMini_MakeVillage_Finish", "Hudson and Rhondson are happily married, and\nTarrey Town is enjoying great prosperity.\n\nAs a sign of appreciation for bringing the town\ntogether and as compensation for your work,\nHudson gave you a hefty amount of gems that\nwere unearthed during the town's construction.\n\nYou wished the couple eternal happiness before\nheading on your way."},
    QuestText{"QL_UMiiMini_MakeVillage_Invite01", "Greyson the Goron has moved to Tarrey Town,\nand his younger brother Pelison tagged along\nfor the ride.\n\nPay the town a visit to make sure they\narrived safely, and check in with Hudson\nwhile you're there."},
    QuestText{"QL_UMiiMini_MakeVillage_Invite02", "A Gerudo by the name of Rhondson has moved\nto Tarrey Town.\n\nPay the town a visit to make sure she arrived\nsafely. Check in with Hudson while you're there."},
    QuestText{"QL_UMiiMini_MakeVillage_Invite03", "A Rito by the name of Fyson has moved to\nTarrey Town to run the general store.\n\nPay the town a visit to make sure he arrived\nsafely, and check in with Hudson while\nyou're there."},
    QuestText{"QL_UMiiMini_MakeVillage_Invite04", "A former Zora priest by the name of Kapson\nhas moved to Tarrey Town!\n\nPay the town a visit to make sure he arrived\nsafely and to see what other shenanigans\nHudson has been up to. There's always\nsomething going on with that guy!"},
    QuestText{"QL_UMiiMini_MakeVillage_Invite05", "Bolson and Karson departed for Tarrey Town.\n\nAll that's left now is to return to the town\nyourself and enjoy Hudson and Rhondson's\nwedding ceremony!\n\nHead back to the town and look for Hudson."},
    QuestText{"QL_UMiiMini_MakeVillage_LookFor01", "You brought Hudson enough wood to get him\nstarted, but now he needs to break the boulders\nscattered across the future site of Tarrey Town.\nHe's asked you to find a Goron strong enough\nto help out.\n\nAccording to the Bolson Construction hiring\nguidelines, you need to seek out a Goron\nwhose name ends in \"son.\" The guidelines are\nunusually specific about this."},
    QuestText{"QL_UMiiMini_MakeVillage_LookFor02", "You delivered more wood to Hudson.\n\nBut now he needs someone who can mend his\nwork clothes. He wants you to find a Gerudo\nskilled at sewing, but remember the stipulation\nin the Bolson Construction hiring guidelines:\nthe Gerudo's name must end in \"son.\""},
    QuestText{"QL_UMiiMini_MakeVillage_LookFor03", "You brought Hudson more wood.\n\nHis next goal is to open up a general store and\ntrade routes, and he thinks a Rito merchant\nwould be perfect for the job.\n\nFind a Rito with the know-how to manage a\nshop and the connections to set up trade,\nand of course, make sure his or her name\nends in \"son.\""},
    QuestText{"QL_UMiiMini_MakeVillage_LookFor04", "You brought Hudson enough wood!\n\nAnd now, as it turns out, Hudson is engaged to\nRhondson! Can you believe it?\n\nThey want to hold a ceremony, so he wants you\nto find a Zora who can officiate. Even though\nthis Zora technically won't be working for\nHudson's company, he would be much more\ncomfortable if the Zora's name ended in \"son.\""},
    QuestText{"QL_UMiiMini_MakeVillage_LookFor05", "Kapson, a Zora and former priest, arrived safely\nin Tarrey Town and began making preparations\nfor the wedding ceremony.\n\nHudson wants to invite Bolson and Karson to\nhis wedding, but he's too busy with preparations\nof his own. Go to Hateno Village to invite Bolson\nand Karson."},
    QuestText{"QL_UMiiMini_MakeVillage_Marry", "Hudson and Rhondson's wedding was a shining\nbeacon in an otherwise dark, dangerous world.\n\nRhondson was a little taken aback by a few of\nthe vows, but everything worked out fine and is\nin perfect compliance with Bolson Construction's\nguidelines.\n\nIt's only polite to give your blessing to the lovely\ncouple who just vowed their undying love, so go\ntalk to Hudson."},
    QuestText{"QL_UMiiMini_MakeVillage_Name", "From the Ground Up"},
    QuestText{"QL_UMiiMini_MakeVillage_Wood01", "You bumped into Hudson in the Akkala region,\nand it sounds like he plans on building a town\nthere as a part of Bolson Construction's\nexpansion. He even has a name picked out—it\nwill be known as Tarrey Town. That said, he is\nmissing a few things required to make a town.\n\nYou know, small things—like lumber.\n\nBring him 10 bundles of wood to get\nhim started."},
    QuestText{"QL_UMiiMini_MakeVillage_Wood02", "Greyson and Pelison arrived safely in\nTarrey Town and got right to work. Greyson\nis breaking apart the boulders, and Pelison\nis selling the ore they find within.\n\nHudson wants to build some more buildings, but\nhe needs more material. Twenty bundles of\nwood should hold him over for this next bunch\nof buildings."},
    QuestText{"QL_UMiiMini_MakeVillage_Wood03", "Rhondson arrived safely in Tarrey Town and got\nright to work. She is not only mending work\nclothes—she also opened up an armor shop!\n\nHudson wants to build more buildings, but he's\nrun out of materials once again.\n\nAnother 30 bundles of wood should cover\nhim for now."},
    QuestText{"QL_UMiiMini_MakeVillage_Wood04", "Fyson arrived safely in Tarrey Town and put\nthe experience he gained from running his\nfamily's shop to good use. He opened up a\ngeneral store!\n\nHudson wants to build another batch of\nbuildings, but he needs more material.\n\nBring him another 50 bundles of wood."},
    QuestText{"QL_UMiiMini_RichmansHobby_Desc", "Hagie in Tarrey Town asked you to defeat the\ntwo Guardians in Torin Wetland and then\nreport back to him.\n\nYou were paid in advance, so you're pretty\nmuch obligated to go through with it."},
    QuestText{"QL_UMiiMini_RichmansHobby_Finish", "You defeated the two Guardians in\nTorin Wetland and reported back to\nHagie before night fell.\n\nThe reward was less than the up-front\npayment..."},
    QuestText{"QL_UMiiMini_RichmansHobby_Name", "Hobbies of the Rich"},
    QuestText{"QL_UotoriMini_RecipeSea_Desc", "Kiana lives in a family of fishermen in\nLurelin Village. She wants to cook her\nfamily's favorite meal, seafood paella,\nbut she's too busy with her daily errands\nand looking after her children to gather\nall the necessary ingredients.\n\nBe a sport and help her out by gathering\nthe ingredients for her. She needs\ngoat butter and a hearty blueshell snail\nto prepare the dish."},
    QuestText{"QL_UotoriMini_RecipeSea_Finish", "You brought Kiana the goat butter and\nhearty blueshell snail required for cooking\nseafood paella. She shared some of the dish\nwith you as thanks!\n\n　　\t/////Recipe/////\n1 Goat Butter\n1 Hearty Blueshell Snail\n1 Mighty Porgy\n1 Rock Salt\n1 Hylian Rice"},
    QuestText{"QL_UotoriMini_RecipeSea_Name", "What's for Dinner?"},
    QuestText{"QL_UotoriMini_RecoverBay_Desc", "Lurelin Village is a fishing village, but the\nresidents have been distressed lately. The\nfisherman Sebasto in particular is in a bind\nbecause a group of monsters have built an\nencampment right on Aris Beach—the best\nfishing spot for miles around.\n\nDefeat the monsters on the beach so the village\ncan resume its regular fishing."},
    QuestText{"QL_UotoriMini_RecoverBay_Exterminate", "You defeated all the monsters occupying the\nencampment on Aris Beach!\n\nGo tell Sebasto the good news."},
    QuestText{"QL_UotoriMini_RecoverBay_Finish", "The monsters that once occupied the\nencampment on Aris Beach have been\ndispatched, and the village's regular\nfishing operations have resumed."},
    QuestText{"QL_UotoriMini_RecoverBay_Name", "Take Back the Sea"},
    QuestText{"QL_UotoriMini_SinkTreasure_Desc", "The retired fisherman Rozel lives a quiet life,\nspending each day simply staring at the sea.\n\nHe shared a legend of a sunken treasure:\n\n\"The treasure sleeps in the center of the\ngolden triangle.\"\n\nYou should check it out."},
    QuestText{"QL_UotoriMini_SinkTreasure_Finish", "Rozel looked happy when he heard about\nthe treasure.\n\nThe idea that there may be more treasure\nstill waiting in the ocean depths tickles your\nsense of adventure."},
    QuestText{"QL_UotoriMini_SinkTreasure_Name", "Sunken Treasure"},
    QuestText{"QL_UotoriMini_SinkTreasure_Salvage", "\"The treasure sleeps in the center of the\ngolden triangle.\"\n\nYou pinpointed the location referred to by\nthe legend and retrieved the treasure from\nthe waters off Clarnet Coast.\n\nYou should tell Rozel the good news."},
    QuestText{"QL_Water_Relic_Desc", "You have been asked to help appease Vah\nRuta, Divine Beast of Water. The task will\nrequire a great many shock arrows.\n\nFind Muzu in Zora's Domain square to\nfind out where to get them."},
    QuestText{"QL_Water_Relic_Finish", "You told King Dorephan everything that's\nhappened so far, and now it seems even\nmembers of the Zora's Domain council\nhave accepted you.\n\nYou've also earned one of the Champion's\ncharms, Mipha's Grace.\n\nDivine Beast Vah Ruta has enshrined itself in\npreparation for the battle with Calamity Ganon."},
    QuestText{"QL_Water_Relic_Name", "Divine Beast Vah Ruta"},
    QuestText{"QL_Water_Relic_Step1", "You asked Muzu where to get the arrows, but\nhe refuses to help because you're a Hylian.\nHowever, he seems willing to cooperate if\nyou can somehow prove that you were\nspecial to Mipha.\n\nYou have the Zora armor that Mipha made\nfor you. Maybe it will be proof enough."},
    QuestText{"QL_Water_Relic_Step1_1", "According to Muzu, you can get shock arrows\nfrom Ploymus Mountain.\n\nWearing the Zora armor allows you to swim\nup waterfalls, so swimming up the waterfall\neast of Zora's Domain will make for a nice\nshortcut.\n\nFirst, you'll need to collect 20 shock arrows."},
    QuestText{"QL_Water_Relic_Step1_2", "You collected the 20 shock arrows you'll need\nto face the Divine Beast. Now head to\nEast Reservoir Lake and meet with Sidon.\n\nThe lake is directly below Shatterback Point,\nthe peak of Ploymus Mountain."},
    QuestText{"QL_Water_Relic_Step2", "You met up with Sidon at East Reservoir Lake\nand are ready to put those shock arrows to\nuse. Their electricity can activate the devices\non Divine Beast Vah Ruta's back."},
    QuestText{"QL_Water_Relic_Step3", "You met up with Sidon at East Reservoir Lake\nand are ready to put those shock arrows to\nuse. Their electricity can activate the devices\non Divine Beast Vah Ruta's back."},
    QuestText{"QL_Water_Relic_Step4", "You activated the devices on\nDivine Beast Vah Ruta's back,\nhalting its barrage.\n\nNow's your chance. Head inside\nand take back the Divine Beast!"},
    QuestText{"QL_Water_Relic_Step5", "You defeated Waterblight Ganon, which\nhad taken control of Divine Beast Vah Ruta.\n\nDivine Beast Vah Ruta has been enshrined\nto the west of Lanayru Great Spring.\n\nReturn to Zora's Domain and report to\nKing Dorephan."},
    QuestText{"QL_Wind_Relic_Battle", "The battle with Divine Beast Vah Medoh\nhas begun!\n\nUse the paraglider to launch into the air for a\ngood vantage point, and then take out all\nthe cannons with your bomb arrows.\n\nBut be careful—if you get too close, you'll run\ninto the Divine Beast's barrier!"},
    QuestText{"QL_Wind_Relic_BattleFinished", "You destroyed all of Divine Beast Vah Medoh's\ncannons and landed on its back, but Teba\nsuffered injuries and had to retreat.\n\nYou must finish what you both started. Enter\nDivine Beast Vah Medoh on your own to stop\nit once and for all!"},
    QuestText{"QL_Wind_Relic_BattlePlaying", "You destroyed all of Divine Beast Vah Medoh's\ncannons and landed on its back, but Teba\nsuffered injuries and had to retreat.\n\nYou must finish what you both started. Enter\nDivine Beast Vah Medoh on your own to stop\nit once and for all!"},
    QuestText{"QL_Wind_Relic_Desc", "Kaneli, elder of Rito Village, wants you to help\na local soldier named Teba. You offered your\nassistance, but first you must find the soldier.\n\nTeba's wife Saki may know where he is. Ask\naround Rito Village to gather more information."},
    QuestText{"QL_Wind_Relic_Dungeon", "You defeated Windblight Ganon, which had\ninfested the insides of Divine Beast Vah Medoh.\n\nThe Divine Beast has been enshrined at the\nhighest point of Rito Village, and moreover,\nit looks like Teba was able to safely return\nto Rito Village.\n\nGo report to Kaneli."},
    QuestText{"QL_Wind_Relic_Finish", "You reported to Kaneli that Divine Beast Vah\nMedoh has regained its senses.\n\nYour efforts have earned you the power of the\nChampion Revali, Revali's Gale."},
    QuestText{"QL_Wind_Relic_Name", "Divine Beast Vah Medoh"},
    QuestText{"QL_Wind_Relic_Parashawl", "Teba won't let you anywhere near\nDivine Beast Vah Medoh unless you can at\nleast hit the targets at the Flight Range.\n\nIf you catch an updraft with your paraglider, it'll\ncarry you high into the sky. Use this technique\nto destroy five targets with arrows within the time\nlimit to prove yourself to Teba."},
    QuestText{"QL_Wind_Relic_ParashawlFinished", "You proved your mettle by hitting the targets at\nthe Flight Range.\n\nWhen it comes time to battle Divine Beast Vah\nMedoh, Teba will draw the focus of its attacks\nso you can focus on destroying its cannons.\n\nTeba will carry you into the sky where\nDivine Beast Vah Medoh awaits."},
    QuestText{"QL_Wind_Relic_ParashawlPlaying", "You proved your mettle by hitting the targets at\nthe Flight Range.\n\nWhen it comes time to battle Divine Beast Vah\nMedoh, Teba will draw the focus of its attacks\nso you can focus on destroying its cannons.\n\nTeba will carry you into the sky where\nDivine Beast Vah Medoh awaits."},
    QuestText{"QL_Wind_Relic_Saki", "You found Saki and asked where Teba went.\nIt sounds like he headed for the Flight Range.\n\nSearch the Flight Range for Teba."},
    QuestText{"QL_Wind_Relic_Step1", "You found Teba at the Flight Range, but he has\nno intention of returning to the village before\nDivine Beast Vah Medoh has been appeased.\n\nHe intends to appease the Divine Beast\nhimself. You had better help him out."},
    QuestText{"QL_ZoraMini_DiveChallenge_Desc", "Gruve wants to see a beautiful dive and asked\nyou to perform one.\n\nEveryone knows a feetfirst dive isn't all that\nbeautiful, so dive in headfirst."},
    QuestText{"QL_ZoraMini_DiveChallenge_Finish", "Your diving and waterfall climbing was so\nbeautiful you made Gruve's very soul flutter\nwith a mighty vigor."},
    QuestText{"QL_ZoraMini_DiveChallenge_Name", "Diving is Beauty!"},
    QuestText{"QL_ZoraMini_DiveChallenge_Step1", "You performed a beautiful dive, and Gruve was\nmost pleased, but now he wants to see you\nclimb the waterfall."},
    QuestText{"QL_ZoraMini_DiveChallenge_Step2", "You climbed the waterfall as requested, and\nGruve was simply blown away.\n\nPay Gruve a visit to hear his final assessment."},
    QuestText{"QL_ZoraMini_FlowedWife_Desc", "Divine Beast Vah Ruta has calmed down, yet\nFronk's wife, Mei, has not yet returned home.\n\nFronk is too discouraged to search for her\nhimself, so search for Mei in his place.\n\nWhere could she be?"},
    QuestText{"QL_ZoraMini_FlowedWife_Finish", "You found Mei fishing in Lake Hylia.\n\nShe left the fish she caught with you and\nhurried back to Fronk."},
    QuestText{"QL_ZoraMini_FlowedWife_Name", "A Wife Washed Away"},
    QuestText{"QL_ZoraMini_HarvestingStone_Desc", "Ledo asked you to bring him ten luminous\nstones to help rebuild Zora's Domain.\n\nApparently there's a place in Upland Zorana\nwhere they're pretty common."},
    QuestText{"QL_ZoraMini_HarvestingStone_Finish", "You gave Ledo 10 luminous stones to aid in\nthe repairs to Zora's Domain."},
    QuestText{"QL_ZoraMini_HarvestingStone_Name", "Luminous Stone Gathering"},
    QuestText{"QL_ZoraMini_ReliefSearch_Desc", "After hearing Jiahto's request, you agreed to\nsearch for the stone monuments in the area\nsurrounding Zora's Domain.\n\nNot counting the monument in Zora's Domain,\nthere are 10 to find in total."},
    QuestText{"QL_ZoraMini_ReliefSearch_Finish", "You found all ten stone monuments and\nreported back to Jiahto.\n\nJiahto will benefit greatly from this."},
    QuestText{"QL_ZoraMini_ReliefSearch_Name", "Zora Stone Monuments"},
    QuestText{"QL_ZoraMini_ReliefSearch_SearchRelief", "You searched the area surrounding Zora's\nDomain high and low and found all ten\nstone monuments.\n\nReport your findings to Jiahto."},
    QuestText{"QL_Zora_FlogMini_Desc", "Tumbo in Zora's Domain wants you to donate\nfive hot-footed frogs to his cause.\n\nApparently hot-footed frogs are pretty easy to\nfind on rainy days."},
    QuestText{"QL_Zora_FlogMini_Finish", "Tumbo gave you an armoranth in exchange for\nfive hot-footed frogs. He seemed pretty\npleased with the whole arrangement."},
    QuestText{"QL_Zora_FlogMini_Name", "Frog Catching"},
    QuestText{"QL_bf2_collabo_Desc", "[Collaboration with Xenoblade Chronicles 2]\n\nThe southern sky from the middle of the largest\nbridge. The eastern sky from the skull's left eye.\nThe southeastern sky from the peak of the tall,\npierced snowy mountain.\n\nLook to the night sky at these locations and\nfind the red shooting stars!\n\nStars left:"},
    QuestText{"QL_bf2_collabo_Finish", "[Collaboration with Xenoblade Chronicles 2]\n\nYou found all three red shooting stars that\nlanded in various parts of Hyrule!\n\nIn Xenoblade Chronicles 2, the people who\ncollect sunken treasure in the Cloud Sea are\ncalled Salvagers. Use the three gears you've\ncollected like a true Salvager!"},
    QuestText{"QL_bf2_collabo_Name", "[Xenoblade Chronicles 2]"},
    QuestText{"QL_isso_treasure_mini_Desc", "You noticed Izra at the Wetland Stable staring\nkeenly into Hylia River.\n\nHis attention was fixed on a treasure chest on\nthe bed of Hylia River, but he is at a loss as\nto how to bring it to the surface."},
    QuestText{"QL_isso_treasure_mini_Finish", "You pulled the sunken treasure chest from the\nbed of Hylia River and reported its contents\nto Izra.\n\nIzra went home satisfied to the Wetland Stable."},
    QuestText{"QL_isso_treasure_mini_Name", "Riverbed Reward"},
    QuestText{"QL_isso_treasure_mini_Step1", "You pulled the sunken treasure chest from the\nbed of Hylia River.\n\nOpen the chest so you can tell Izra what you\nfound inside."},
    QuestText{"QL_isso_treasure_mini_Step2", "You pulled the sunken treasure chest from the\nbed of Hylia River.\n\nTell Izra what you found inside."},
}};
