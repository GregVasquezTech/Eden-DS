    ItemText{"Obj_Porch_Bow", "Bow Stash", "弓をコンパクトに収納できるInventory\nたくさんあればそれだけ多くの弓を\n持ち運べる"},
    ItemText{"Obj_Porch_Shield", "Shield Stash", "盾をコンパクトに収納できるInventory\nたくさんあればそれだけ多くの盾を\n持ち運べる"},
    ItemText{"Obj_Porch_Weapon", "Weapon Stash", "武器をコンパクトに収納できるInventory\nたくさんあればそれだけ多くの武器を\n持ち運べる"},
    ItemText{"Obj_ProofBook", "Classified Envelope", "Inside the envelope is a picture of a\nbeautiful young woman of the Sheikah tribe."},
    ItemText{"Obj_ProofGiantKiller", "Medal of Honor: Hinox", "A medal presented by Kilton in somber honor\nof having defeated every Hinox. Ending a\nmonster's life is never an easy task, but at\ntimes it is a necessary one."},
    ItemText{"Obj_ProofGolemKiller", "Medal of Honor: Talus", "A medal presented by Kilton in somber honor\nof having defeated every Stone Talus. Taking\nthe life of a monster is a solemn act, but at\ntimes it must be done."},
    ItemText{"Obj_ProofKorok", "Hestu's Gift", "A gift of friendship given to you by Hestu.\nIt smells pretty bad."},
    ItemText{"Obj_ProofSandwormKiller", "Medal of Honor: Molduga", "A medal presented by Kilton in somber honor\nof having defeated every Molduga. Slaying a\nmonster is a heavy burden to bear. You must\nsteel yourself to carry that weight."},
    ItemText{"Obj_RemainInsideMap", "Relic Map", ""},
