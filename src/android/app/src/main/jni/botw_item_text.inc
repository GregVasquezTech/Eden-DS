    ItemText{"Obj_Photo_BossEnemy", "Elite Enemy Picture", "A picture of a powerful monster that at one\ntime stood in your way."},
    ItemText{"Obj_Photo_Enemy", "Enemy Picture", "A picture of one of the various monsters that\ncan be found throughout Hyrule."},
    ItemText{"Obj_Photo_Material", "Material Picture", "A picture of a cooking ingredient, such as an\napple or a mushroom."},
    ItemText{"Obj_Photo_Other", "Other Picture", "A picture of an exciting subject, such as a \ntreasure chest or ore."},
    ItemText{"Obj_Photo_Weapon", "Weapon Picture", "A picture of a battle-tested weapon, such as\na sword, spear, or bow."},
